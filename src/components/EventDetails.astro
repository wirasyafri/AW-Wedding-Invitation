---
const { settings } = Astro.props;

// Construct Google Calendar URLs dynamically
const getAkadCalUrl = () => {
    const text = `Akad Nikah ${settings.groom_name_short} & ${settings.bride_name_short}`;
    const dates = `${settings.akad_start_iso}/${settings.akad_end_iso}`;
    const details = `Acara Akad Nikah ${settings.groom_name_full} & ${settings.bride_name_full} di ${settings.akad_location_name}.`;
    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(text)}&dates=${dates}&details=${encodeURIComponent(details)}&location=${encodeURIComponent(settings.akad_location_name)}`;
};

const getResepsiCalUrl = () => {
    const text = `Resepsi Pernikahan ${settings.groom_name_short} & ${settings.bride_name_short}`;
    const dates = `${settings.resepsi_start_iso}/${settings.resepsi_end_iso}`;
    const details = `Acara Resepsi Pernikahan ${settings.groom_name_full} & ${settings.bride_name_full} di ${settings.resepsi_location_name}.`;
    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(text)}&dates=${dates}&details=${encodeURIComponent(details)}&location=${encodeURIComponent(settings.resepsi_location_name)}`;
};
---
<section class="py-24 px-4 bg-royal-cream">
    <div class="max-w-5xl mx-auto text-center">
        <span class="font-cinzel uppercase tracking-[0.3em] text-xs text-stone-600 block mb-2">Rangkaian Acara</span>
        <h2 class="font-script text-5xl md:text-6xl text-gold-dark mb-16">Save The Date</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
            <!-- Akad Nikah -->
            <div class="bg-white p-8 rounded-2xl shadow-xl border border-gold/30 relative reveal">
                <div class="absolute top-0 right-0 bg-gold text-stone-950 font-cinzel text-xs font-bold px-4 py-1 rounded-tr-2xl rounded-bl-lg">Sesi 1</div>
                <div class="text-gold text-4xl mb-4"><i class="fa-solid fa-ring"></i></div>
                <h3 class="font-cinzel font-bold text-2xl text-stone-900 mb-2">Akad Nikah</h3>
                <p class="text-stone-600 text-sm mb-6">{settings.akad_date}<br>Pukul {settings.akad_time}</p>
                <div class="bg-stone-50 p-4 rounded-xl border border-stone-200 mb-6 text-sm text-stone-700 text-left">
                    <strong>{settings.akad_location_name}</strong><br>{settings.akad_location_address}
                </div>
                
                <div class="relative inline-block w-full text-left">
                    <button class="cal-dropdown-btn w-full inline-flex items-center justify-center bg-stone-900 border border-stone-800 text-gold font-cinzel text-xs font-bold py-3 rounded-lg hover:bg-gold hover:text-stone-950 transition cursor-pointer">
                        <i class="fa-regular fa-calendar-plus mr-2"></i> Tambahkan ke Kalendar
                    </button>
                    <div class="cal-dropdown-menu absolute left-0 right-0 mt-2 z-20 hidden bg-stone-950 border border-gold/30 rounded-lg shadow-2xl p-1 overflow-hidden transition-all duration-300">
                        <a href={getAkadCalUrl()} target="_blank" class="flex items-center gap-3 px-4 py-2.5 text-stone-300 hover:bg-gold hover:text-stone-950 rounded-md text-xs transition cursor-pointer">
                            <i class="fa-brands fa-google w-4"></i> Google Calendar (Android)
                        </a>
                        <button 
                            class="ical-btn w-full flex items-center gap-3 px-4 py-2.5 text-stone-300 hover:bg-gold hover:text-stone-950 rounded-md text-xs transition text-left cursor-pointer" 
                            data-title={`Akad Nikah ${settings.groom_name_short} & ${settings.bride_name_short}`}
                            data-start={settings.akad_start_iso} 
                            data-end={settings.akad_end_iso} 
                            data-desc={`Acara Akad Nikah ${settings.groom_name_full} & ${settings.bride_name_full}`}
                            data-loc={settings.akad_location_name}
                        >
                            <i class="fa-solid fa-calendar-days w-4"></i> Apple Calendar (iOS)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Resepsi -->
            <div class="bg-white p-8 rounded-2xl shadow-xl border border-gold/30 relative reveal">
                <div class="absolute top-0 right-0 bg-gold text-stone-950 font-cinzel text-xs font-bold px-4 py-1 rounded-tr-2xl rounded-bl-lg">Sesi 2</div>
                <div class="text-gold text-4xl mb-4"><i class="fa-solid fa-champagne-glasses"></i></div>
                <h3 class="font-cinzel font-bold text-2xl text-stone-900 mb-2">Resepsi Pernikahan</h3>
                <p class="text-stone-600 text-sm mb-6">{settings.resepsi_date}<br>Pukul {settings.resepsi_time}</p>
                <div class="bg-stone-50 p-4 rounded-xl border border-stone-200 mb-6 text-sm text-stone-700 text-left">
                    <strong>{settings.resepsi_location_name}</strong><br>{settings.resepsi_location_address}
                </div>
                
                <div class="relative inline-block w-full text-left">
                    <button class="cal-dropdown-btn w-full inline-flex items-center justify-center bg-stone-900 border border-stone-800 text-gold font-cinzel text-xs font-bold py-3 rounded-lg hover:bg-gold hover:text-stone-950 transition cursor-pointer">
                        <i class="fa-regular fa-calendar-plus mr-2"></i> Tambahkan ke Kalendar
                    </button>
                    <div class="cal-dropdown-menu absolute left-0 right-0 mt-2 z-20 hidden bg-stone-950 border border-gold/30 rounded-lg shadow-2xl p-1 overflow-hidden transition-all duration-300">
                        <a href={getResepsiCalUrl()} target="_blank" class="flex items-center gap-3 px-4 py-2.5 text-stone-300 hover:bg-gold hover:text-stone-950 rounded-md text-xs transition cursor-pointer">
                            <i class="fa-brands fa-google w-4"></i> Google Calendar (Android)
                        </a>
                        <button 
                            class="ical-btn w-full flex items-center gap-3 px-4 py-2.5 text-stone-300 hover:bg-gold hover:text-stone-950 rounded-md text-xs transition text-left cursor-pointer" 
                            data-title={`Resepsi Pernikahan ${settings.groom_name_short} & ${settings.bride_name_short}`}
                            data-start={settings.resepsi_start_iso} 
                            data-end={settings.resepsi_end_iso} 
                            data-desc={`Acara Resepsi Pernikahan ${settings.groom_name_full} & ${settings.bride_name_full}`}
                            data-loc={settings.resepsi_location_name}
                        >
                            <i class="fa-solid fa-calendar-days w-4"></i> Apple Calendar (iOS)
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Google Maps Embed Section -->
        <div class="reveal max-w-5xl mx-auto bg-white p-6 rounded-2xl shadow-xl border border-gold/30">
            <h3 class="font-cinzel font-bold text-xl text-stone-900 mb-4">Peta Lokasi Acara</h3>
            <div class="w-full h-96 rounded-xl overflow-hidden shadow-inner border border-stone-200">
                <iframe 
                    src={settings.google_map_embed} 
                    class="w-full h-full border-0" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</section>

<script>
    // Handle opening/closing dropdown menus
    const dropdownBtns = document.querySelectorAll('.cal-dropdown-btn');
    dropdownBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const parent = btn.parentElement;
            const menu = parent?.querySelector('.cal-dropdown-menu');

            // Close other open menus
            document.querySelectorAll('.cal-dropdown-menu').forEach(m => {
                if (m !== menu) m.classList.add('hidden');
            });

            menu?.classList.toggle('hidden');
        });
    });

    // Close menus on click outside
    document.addEventListener('click', () => {
        document.querySelectorAll('.cal-dropdown-menu').forEach(menu => {
            menu.classList.add('hidden');
        });
    });

    // Handle iCal download logic
    const icalBtns = document.querySelectorAll('.ical-btn');
    icalBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const title = btn.getAttribute('data-title') || 'Pernikahan Wira & Ayu';
            const start = btn.getAttribute('data-start') || '20270105T010000Z';
            const end = btn.getAttribute('data-end') || '20270105T070000Z';
            const desc = btn.getAttribute('data-desc') || 'Undangan Pernikahan';
            const loc = btn.getAttribute('data-loc') || 'Ocean Garden Tepi Brantas Kepanjen';

            const icsContent = [
                'BEGIN:VCALENDAR',
                'VERSION:2.0',
                'PRODID:-//Wedding Invitation//NONSGML v1.0//EN',
                'BEGIN:VEVENT',
                `SUMMARY:${title}`,
                `DTSTART:${start}`,
                `DTEND:${end}`,
                `DESCRIPTION:${desc}`,
                `LOCATION:${loc}`,
                'END:VEVENT',
                'END:VCALENDAR'
            ].join('\r\n');

            const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.setAttribute('download', `${title.replace(/\s+/g, '_')}.ics`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
    });
</script>
