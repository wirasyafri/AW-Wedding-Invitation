---
---
<section class="py-24 px-4 bg-royal-cream">
    <div class="max-w-5xl mx-auto text-center">
        <span class="font-cinzel uppercase tracking-[0.3em] text-xs text-stone-600 block mb-2">Rangkaian Acara</span>
        <h2 class="font-script text-5xl md:text-6xl text-gold-dark mb-16">Save The Date</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Akad Nikah -->
            <div class="bg-white p-8 rounded-2xl shadow-xl border border-gold/30 relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-gold text-stone-950 font-cinzel text-xs font-bold px-4 py-1 rounded-bl-lg">Sesi 1</div>
                <div class="text-gold text-4xl mb-4"><i class="fa-solid fa-ring"></i></div>
                <h3 class="font-cinzel font-bold text-2xl text-stone-900 mb-2">Akad Nikah</h3>
                <p class="text-stone-600 text-sm mb-6">Minggu, 5 Januari 2027<br>Pukul 08.00 WIB - Selesai</p>
                <div class="bg-stone-50 p-4 rounded-xl border border-stone-200 mb-6 text-sm text-stone-700">
                    <strong>Ocean Garden Tepi Brantas Kepanjen</strong><br>Sawah, Kedungpedaringan, Kec. Kepanjen, Kabupaten Malang, Jawa Timur 65163
                </div>
                <a href="https://maps.app.goo.gl/RKY2Gi1PithvsSJ67" target="_blank" class="inline-flex items-center justify-center w-full bg-gold/10 border border-gold text-gold-dark font-cinzel text-xs font-bold py-3 rounded-lg hover:bg-gold hover:text-stone-950 transition cursor-pointer">
                    <i class="fa-solid fa-map-location-dot mr-2"></i> Lihat Lokasi Google Maps
                </a>
            </div>

            <!-- Resepsi -->
            <div class="bg-white p-8 rounded-2xl shadow-xl border border-gold/30 relative overflow-hidden">
                <div class="absolute top-0 right-0 bg-gold text-stone-950 font-cinzel text-xs font-bold px-4 py-1 rounded-bl-lg">Sesi 2</div>
                <div class="text-gold text-4xl mb-4"><i class="fa-solid fa-champagne-glasses"></i></div>
                <h3 class="font-cinzel font-bold text-2xl text-stone-900 mb-2">Resepsi Pernikahan</h3>
                <p class="text-stone-600 text-sm mb-6">Minggu, 5 Januari 2027<br>Pukul 11.00 WIB - 14.00 WIB</p>
                <div class="bg-stone-50 p-4 rounded-xl border border-stone-200 mb-6 text-sm text-stone-700">
                    <strong>Ocean Garden Tepi Brantas Kepanjen</strong><br>Sawah, Kedungpedaringan, Kec. Kepanjen, Kabupaten Malang, Jawa Timur 65163
                </div>
                <a href="https://maps.app.goo.gl/RKY2Gi1PithvsSJ67" target="_blank" class="inline-flex items-center justify-center w-full bg-gold/10 border border-gold text-gold-dark font-cinzel text-xs font-bold py-3 rounded-lg hover:bg-gold hover:text-stone-950 transition cursor-pointer">
                    <i class="fa-solid fa-map-location-dot mr-2"></i> Lihat Lokasi Google Maps
                </a>
            </div>
        </div>
    </div>
</section>
