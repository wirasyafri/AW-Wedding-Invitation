---
const { settings } = Astro.props;

const weddingDate = settings.akad_date || settings.resepsi_date;
const locationName = settings.akad_location_name || settings.resepsi_location_name;
const locationAddress = settings.akad_location_address || settings.resepsi_location_address;

// Construct Google Calendar URLs dynamically
const getCombinedCalUrl = () => {
    const text = `Pernikahan ${settings.groom_name_short} & ${settings.bride_name_short}`;
    const start = settings.akad_start_iso || settings.resepsi_start_iso;
    const end = settings.resepsi_end_iso || settings.akad_end_iso;
    const dates = `${start}/${end}`;
    const details = `Rangkaian Acara Pernikahan ${settings.groom_name_full} & ${settings.bride_name_full}\n• Akad Nikah: ${settings.akad_time}\n• Resepsi: ${settings.resepsi_time}\nLokasi: ${locationName}`;
    const loc = `${locationName}${locationAddress ? `, ${locationAddress}` : ''}`;
    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(text)}&dates=${dates}&details=${encodeURIComponent(details)}&location=${encodeURIComponent(loc)}`;
};

const getAkadCalUrl = () => {
    const text = `Akad Nikah ${settings.groom_name_short} & ${settings.bride_name_short}`;
    const dates = `${settings.akad_start_iso}/${settings.akad_end_iso}`;
    const details = `Acara Akad Nikah ${settings.groom_name_full} & ${settings.bride_name_full} di ${locationName}.`;
    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(text)}&dates=${dates}&details=${encodeURIComponent(details)}&location=${encodeURIComponent(locationName)}`;
};

const getResepsiCalUrl = () => {
    const text = `Resepsi Pernikahan ${settings.groom_name_short} & ${settings.bride_name_short}`;
    const dates = `${settings.resepsi_start_iso}/${settings.resepsi_end_iso}`;
    const details = `Acara Resepsi Pernikahan ${settings.groom_name_full} & ${settings.bride_name_full} di ${locationName}.`;
    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(text)}&dates=${dates}&details=${encodeURIComponent(details)}&location=${encodeURIComponent(locationName)}`;
};
---
<section class="py-24 px-4 bg-royal-cream">
    <div class="max-w-5xl mx-auto text-center">
        <span class="font-cinzel uppercase tracking-[0.3em] text-xs text-stone-600 block mb-2">Rangkaian Acara</span>
        <h2 class="font-script text-5xl md:text-6xl text-gold-dark mb-3">Save The Date</h2>
        {weddingDate && (
            <p class="font-cinzel text-base md:text-lg text-stone-800 font-semibold tracking-wider mb-12 flex items-center justify-center gap-2">
                <i class="fa-regular fa-calendar-check text-gold-dark"></i>
                <span>{weddingDate}</span>
            </p>
        )}

        <!-- Combined Akad & Resepsi Single Card -->
        <div class="reveal max-w-4xl mx-auto bg-white p-6 sm:p-10 md:p-12 rounded-3xl shadow-xl border border-gold/30 mb-12 relative overflow-hidden">
            <!-- Subtle Top Gold Accent Bar -->
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-gold-light via-gold to-gold-dark"></div>

            <!-- Two-Column Sessions Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
                <!-- Akad Nikah (Sesi 1) -->
                <div class="flex flex-col items-center p-6 sm:p-8 rounded-2xl bg-stone-50/80 border border-stone-200/80 hover:border-gold/40 transition">
                    <div class="w-14 h-14 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center text-gold text-2xl mb-3">
                        <i class="fa-solid fa-ring"></i>
                    </div>
                    <span class="inline-block px-3 py-0.5 bg-gold text-stone-950 font-cinzel text-[11px] font-bold rounded-full mb-3 uppercase tracking-wider">
                        Sesi 1
                    </span>
                    <h3 class="font-cinzel font-bold text-xl text-stone-900 mb-2">Akad Nikah</h3>
                    <p class="text-gold-dark font-bold text-sm">Pukul {settings.akad_time}</p>
                </div>

                <!-- Resepsi Pernikahan (Sesi 2) -->
                <div class="flex flex-col items-center p-6 sm:p-8 rounded-2xl bg-stone-50/80 border border-stone-200/80 hover:border-gold/40 transition">
                    <div class="w-14 h-14 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center text-gold text-2xl mb-3">
                        <i class="fa-solid fa-champagne-glasses"></i>
                    </div>
                    <span class="inline-block px-3 py-0.5 bg-gold text-stone-950 font-cinzel text-[11px] font-bold rounded-full mb-3 uppercase tracking-wider">
                        Sesi 2
                    </span>
                    <h3 class="font-cinzel font-bold text-xl text-stone-900 mb-2">Resepsi Pernikahan</h3>
                    <p class="text-gold-dark font-bold text-sm">Pukul {settings.resepsi_time}</p>
                </div>
            </div>

            <!-- Unified Single Location Details -->
            <div class="bg-stone-50/90 p-5 sm:p-6 rounded-2xl border border-stone-200/90 text-center md:text-left mt-6 flex flex-col md:flex-row items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-gold/10 text-gold flex items-center justify-center shrink-0 text-xl border border-gold/30">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <div class="flex-1">
                    <span class="font-cinzel uppercase tracking-wider text-[11px] text-gold-dark font-bold block mb-0.5">Lokasi Acara</span>
                    <h4 class="font-cinzel font-bold text-lg text-stone-900 leading-snug">{locationName}</h4>
                    <p class="text-stone-600 text-xs sm:text-sm mt-1 leading-relaxed">{locationAddress}</p>
                </div>
            </div>

            <!-- Save to Calendar Button & Dropdown -->
            <div class="relative mt-8 max-w-sm mx-auto">
                <button class="cal-dropdown-btn w-full inline-flex items-center justify-center bg-stone-900 border border-stone-800 text-gold font-cinzel text-xs font-bold py-3.5 px-6 rounded-xl hover:bg-gold hover:text-stone-950 transition cursor-pointer shadow-md">
                    <i class="fa-regular fa-calendar-plus mr-2.5 text-sm"></i> Simpan ke Kalender
                    <i class="fa-solid fa-chevron-down ml-2 text-[10px] opacity-70"></i>
                </button>
                <div class="cal-dropdown-menu absolute left-0 right-0 mt-2 z-20 hidden bg-stone-950 border border-gold/30 rounded-xl shadow-2xl p-2 overflow-hidden transition-all duration-300">
                    <a href={getCombinedCalUrl()} target="_blank" class="flex items-center gap-3 px-4 py-2.5 text-stone-200 hover:bg-gold hover:text-stone-950 rounded-lg text-xs font-medium transition cursor-pointer">
                        <i class="fa-brands fa-google w-4 text-sm text-gold"></i> Google Calendar (Semua Acara)
                    </a>
                    <a href={getAkadCalUrl()} target="_blank" class="flex items-center gap-3 px-4 py-2 text-stone-400 hover:bg-gold hover:text-stone-950 rounded-lg text-xs transition cursor-pointer">
                        <i class="fa-solid fa-ring w-4 text-xs"></i> Google Calendar (Khusus Akad)
                    </a>
                    <a href={getResepsiCalUrl()} target="_blank" class="flex items-center gap-3 px-4 py-2 text-stone-400 hover:bg-gold hover:text-stone-950 rounded-lg text-xs transition cursor-pointer">
                        <i class="fa-solid fa-champagne-glasses w-4 text-xs"></i> Google Calendar (Khusus Resepsi)
                    </a>
                    <div class="my-1 border-t border-stone-800"></div>
                    <button 
                        class="ical-btn w-full flex items-center gap-3 px-4 py-2.5 text-stone-200 hover:bg-gold hover:text-stone-950 rounded-lg text-xs font-medium transition text-left cursor-pointer" 
                        data-title={`Pernikahan ${settings.groom_name_short} & ${settings.bride_name_short}`}
                        data-start={settings.akad_start_iso || settings.resepsi_start_iso} 
                        data-end={settings.resepsi_end_iso || settings.akad_end_iso} 
                        data-desc={`Acara Pernikahan ${settings.groom_name_full} & ${settings.bride_name_full}\n• Akad: ${settings.akad_time}\n• Resepsi: ${settings.resepsi_time}`}
                        data-loc={`${locationName}${locationAddress ? ` - ${locationAddress}` : ''}`}
                    >
                        <i class="fa-solid fa-calendar-days w-4 text-sm text-gold"></i> Apple Calendar / ICS (iOS)
                    </button>
                </div>
            </div>
        </div>

        <!-- Google Maps Embed Section -->
        <div class="reveal max-w-4xl mx-auto bg-white p-6 rounded-2xl shadow-xl border border-gold/30">
            <h3 class="font-cinzel font-bold text-xl text-stone-900 mb-4">Peta Lokasi Acara</h3>
            <div class="w-full h-96 rounded-xl overflow-hidden shadow-inner border border-stone-200">
                <iframe 
                    src={settings.google_map_embed} 
                    class="w-full h-full border-0" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</section>

<script>
    // Handle opening/closing dropdown menus
    const dropdownBtns = document.querySelectorAll('.cal-dropdown-btn');
    dropdownBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const parent = btn.parentElement;
            const menu = parent?.querySelector('.cal-dropdown-menu');

            // Close other open menus
            document.querySelectorAll('.cal-dropdown-menu').forEach(m => {
                if (m !== menu) m.classList.add('hidden');
            });

            menu?.classList.toggle('hidden');
        });
    });

    // Close menus on click outside
    document.addEventListener('click', () => {
        document.querySelectorAll('.cal-dropdown-menu').forEach(menu => {
            menu.classList.add('hidden');
        });
    });

    // Handle iCal download logic
    const icalBtns = document.querySelectorAll('.ical-btn');
    icalBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const title = btn.getAttribute('data-title') || 'Pernikahan Wira & Ayu';
            const start = btn.getAttribute('data-start') || '20270105T010000Z';
            const end = btn.getAttribute('data-end') || '20270105T070000Z';
            const desc = btn.getAttribute('data-desc') || 'Undangan Pernikahan';
            const loc = btn.getAttribute('data-loc') || 'Ocean Garden Tepi Brantas Kepanjen';

            const icsContent = [
                'BEGIN:VCALENDAR',
                'VERSION:2.0',
                'PRODID:-//Wedding Invitation//NONSGML v1.0//EN',
                'BEGIN:VEVENT',
                `SUMMARY:${title}`,
                `DTSTART:${start}`,
                `DTEND:${end}`,
                `DESCRIPTION:${desc}`,
                `LOCATION:${loc}`,
                'END:VEVENT',
                'END:VCALENDAR'
            ].join('\r\n');

            const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.setAttribute('download', `${title.replace(/\s+/g, '_')}.ics`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
    });
</script>
