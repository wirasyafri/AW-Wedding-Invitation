---
---
<section class="py-24 px-4 bg-stone-900 text-stone-100">
    <div class="max-w-3xl mx-auto reveal">
        <div class="text-center mb-12">
            <span class="font-cinzel uppercase tracking-[0.3em] text-xs text-gold block mb-2">Kehadiran & Doa</span>
            <h2 class="font-script text-5xl md:text-6xl text-gold-light mb-4">RSVP & Ucapan</h2>
            <p class="text-stone-400 text-sm">Berikan konfirmasi kehadiran serta doa restu terbaik Anda untuk kedua mempelai.</p>
        </div>

        <form id="rsvp-form" class="bg-stone-950/80 p-8 rounded-2xl border border-gold/30 shadow-2xl space-y-6 mb-12">
            <div>
                <label class="block font-cinzel text-xs text-gold uppercase tracking-wider mb-2">Nama Lengkap</label>
                <input type="text" id="rsvp-name" required placeholder="Masukkan nama Anda" class="w-full bg-stone-900 border border-stone-800 rounded-lg px-4 py-3 text-stone-100 focus:outline-none focus:border-gold transition">
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block font-cinzel text-xs text-gold uppercase tracking-wider mb-2">Konfirmasi Kehadiran</label>
                    <select id="rsvp-status" class="w-full bg-stone-900 border border-stone-800 rounded-lg px-4 py-3 text-stone-100 focus:outline-none focus:border-gold transition">
                        <option value="Hadir">Hadir (Hadir di Acara)</option>
                        <option value="Berhalangan">Berhalangan Hadir</option>
                    </select>
                </div>
                <div>
                    <label class="block font-cinzel text-xs text-gold uppercase tracking-wider mb-2">Jumlah Tamu</label>
                    <select id="rsvp-guests" class="w-full bg-stone-900 border border-stone-800 rounded-lg px-4 py-3 text-stone-100 focus:outline-none focus:border-gold transition">
                        <option value="1 Orang">1 Orang</option>
                        <option value="2 Orang">2 Orang</option>
                        <option value="Lebih dari 2 Orang">Lebih dari 2 Orang</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="block font-cinzel text-xs text-gold uppercase tracking-wider mb-2">Ucapan & Doa Restu</label>
                <textarea id="rsvp-message" rows="4" required placeholder="Tuliskan ucapan atau doa restu..." class="w-full bg-stone-900 border border-stone-800 rounded-lg px-4 py-3 text-stone-100 focus:outline-none focus:border-gold transition"></textarea>
            </div>
            <div class="flex flex-col gap-3">
                <button type="submit" id="rsvp-submit-btn" class="w-full py-4 font-cinzel text-sm uppercase tracking-widest text-stone-900 font-bold rounded-lg bg-gradient-to-r from-gold-light via-gold to-gold-dark shadow-lg hover:opacity-95 transition cursor-pointer">
                    Kirim Konfirmasi & Ucapan
                </button>
                <a id="rsvp-wa-btn" href="#" target="_blank" class="w-full py-4 font-cinzel text-sm uppercase tracking-widest text-emerald-400 border border-emerald-500/30 font-bold rounded-lg bg-emerald-950/20 shadow-lg hover:bg-emerald-500 hover:text-stone-950 transition cursor-pointer hidden text-center flex items-center justify-center">
                    <i class="fa-brands fa-whatsapp mr-2 text-lg"></i> Kirim via WhatsApp
                </a>
            </div>
        </form>

        <!-- Wishes Stream Container -->
        <div class="bg-stone-950/80 p-8 rounded-2xl border border-gold/30 shadow-2xl">
            <h3 class="font-cinzel text-lg text-gold mb-6 border-b border-stone-800 pb-3 flex items-center justify-between">
                <span>Daftar Ucapan Tamu</span>
                <span id="wishes-count" class="text-xs bg-gold/10 text-gold px-3 py-1 rounded-full border border-gold/30">0 Ucapan</span>
            </h3>
            <div id="wishes-list" class="space-y-4 max-h-96 overflow-y-auto pr-2">
                <!-- Comments rendered by JS -->
            </div>
        </div>
    </div>
</section>

<script>
    interface Wish {
        id: number;
        created_at: string;
        name: string;
        status: string;
        message: string;
        likes: number;
        guests: string;
    }

    function escapeHTML(str: string) {
        return str.replace(/[&<>'"]/g, 
            tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
        );
    }

    function triggerToast(text: string) {
        const toast = document.getElementById('toast');
        if (toast) {
            toast.innerText = text;
            toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, -20px)';
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, 0)';
            }, 3000);
        }
    }

    function getRelativeTime(timestamp: number) {
        if (!timestamp) return 'Baru saja';
        const diff = Date.now() - timestamp;
        const mins = Math.floor(diff / 60000);
        if (mins < 1) return 'Baru saja';
        const hours = Math.floor(mins / 60);
        if (hours < 1) return `${mins} menit yang lalu`;
        const days = Math.floor(hours / 24);
        if (days < 1) return `${hours} jam yang lalu`;
        return `${days} hari yang lalu`;
    }

    let wishesCache: Wish[] = [];

    async function fetchWishes() {
        try {
            const res = await fetch('/api/wishes');
            if (res.ok) {
                wishesCache = await res.json();
                renderWishesList(wishesCache);
            }
        } catch (e) {
            console.error("Failed to fetch wishes", e);
        }
    }

    function renderWishesList(wishes: Wish[]) {
        const list = document.getElementById('wishes-list');
        const countElem = document.getElementById('wishes-count');
        if (!list || !countElem) return;

        countElem.innerText = wishes.length + ' Ucapan';

        list.innerHTML = wishes.map(wish => {
            const badgeClass = wish.status === 'Hadir' 
                ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' 
                : 'bg-amber-500/10 text-amber-400 border-amber-500/20';

            const timeVal = wish.created_at ? new Date(wish.created_at).getTime() : Date.now();
            // Determine if this wish has already been liked by this browser
            const liked = localStorage.getItem(`liked_${wish.id}`) === 'true';

            return `
                <div class="bg-stone-900/80 p-4 rounded-xl border border-stone-800 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <h4 class="font-bold text-gold text-sm">${escapeHTML(wish.name)}</h4>
                            <span class="text-[10px] ${badgeClass} px-2 py-0.5 rounded border">${wish.status}</span>
                        </div>
                        <p class="text-stone-300 text-xs leading-relaxed">${escapeHTML(wish.message)}</p>
                    </div>
                    <div class="flex items-center justify-between mt-3 pt-2 border-t border-stone-800/40">
                        <span class="text-[10px] text-stone-500">${getRelativeTime(timeVal)}</span>
                        <button class="like-btn flex items-center gap-1.5 ${liked ? 'text-rose-500' : 'text-stone-400'} hover:text-rose-500 text-xs font-cinzel transition cursor-pointer" data-id="${wish.id}" data-liked="${liked}">
                            <i class="fa-solid fa-heart text-[10px] ${liked ? 'text-rose-500' : 'text-stone-500'} hover:text-rose-500 transition-colors"></i>
                            <span>${wish.likes || 0}</span>
                        </button>
                    </div>
                </div>
            `;        }).join('');

        // Attach heart reaction event listeners
        document.querySelectorAll('.like-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');
                if (!id) return;
                const span = btn.querySelector('span');
                if (!span) return;
                const alreadyLiked = localStorage.getItem(`liked_${id}`) === 'true';
                if (alreadyLiked) {
                    // Unlike flow
                    const newCount = Math.max(0, Number(span.innerText) - 1);
                    span.innerText = String(newCount);
                    localStorage.removeItem(`liked_${id}`);
                    btn.classList.remove('text-rose-500');
                    btn.classList.add('text-stone-400');
                    try {
                        const res = await fetch('/api/like', {
                            method: 'DELETE',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id })
                        });
                        if (res.ok) {
                            triggerToast("Ucapan tidak disukai");
                            fetchWishes();
                        }
                    } catch (e) {
                        console.error('Failed to unlike', e);
                    }
                } else {
                    // Like flow
                    const newCount = (Number(span.innerText) || 0) + 1;
                    span.innerText = String(newCount);
                    localStorage.setItem(`liked_${id}`, 'true');
                    btn.classList.remove('text-stone-400');
                    btn.classList.add('text-rose-500');
                    try {
                        const res = await fetch('/api/like', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id })
                        });
                        if (res.ok) {
                            triggerToast("Ucapan disukai!");
                            fetchWishes();
                        }
                    } catch (e) {
                        console.error('Failed to like', e);
                    }
                }
            });
        });
    }

    // Initialize wishes wall by fetching from server API
    fetchWishes();
    // Prefill name from URL query parameter ?to=
    const urlParams = new URLSearchParams(window.location.search);
    const toParam = urlParams.get('to');
    if (toParam) {
        const nameInput = document.getElementById('rsvp-name') as HTMLInputElement;
        if (nameInput) {
            nameInput.value = toParam;
        }
    }

    const form = document.getElementById('rsvp-form') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        const nameElem = document.getElementById('rsvp-name') as HTMLInputElement;
        const statusElem = document.getElementById('rsvp-status') as HTMLSelectElement;
        const guestsElem = document.getElementById('rsvp-guests') as HTMLSelectElement;
        const messageElem = document.getElementById('rsvp-message') as HTMLTextAreaElement;

        if (!nameElem || !statusElem || !guestsElem || !messageElem) return;

        const wishData = {
            name: nameElem.value,
            status: statusElem.value,
            guests: guestsElem.value,
            message: messageElem.value
        };

        // Submit to backend database API
        try {
            const res = await fetch('/api/wishes', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(wishData)
            });
            if (res.ok) {
                fetchWishes(); // refresh local comments feed
                
                // Configure WhatsApp Button based on admin settings
                const whatsappEnabled = localStorage.getItem('whatsappEnabled') !== 'false';
                const weddingPhoneNumber = localStorage.getItem('whatsappNumber') || "6287850112205"; // default fallback
                if (whatsappEnabled) {
                    const waMessage = `Halo Wira & Ayu, saya *${wishData.name}* ingin mengonfirmasi kehadiran di acara pernikahan Anda.\n\n*Konfirmasi Kehadiran:* ${wishData.status}\n*Jumlah Tamu:* ${wishData.guests}\n\n*Ucapan & Doa:* \n"${wishData.message}"`;
                    const waUrl = `https://api.whatsapp.com/send?phone=${weddingPhoneNumber}&text=${encodeURIComponent(waMessage)}`;
                    const waBtn = document.getElementById('rsvp-wa-btn');
                    if (waBtn) {
                        waBtn.setAttribute('href', waUrl);
                        waBtn.classList.remove('hidden');
                    }
                } else {
                    const waBtn = document.getElementById('rsvp-wa-btn');
                    if (waBtn) {
                        waBtn.classList.add('hidden');
                    }
                }

                form.reset();
                triggerToast("Konfirmasi & ucapan tersimpan! Klik tombol WhatsApp di bawah jika ingin mengirim pesan.");
            } else {
                const errData = await res.json();
                triggerToast("Gagal menyimpan: " + (errData.error || "Kesalahan database"));
            }
        } catch (err) {
            console.error("Failed to post wish to server", err);
            triggerToast("Gagal terhubung ke database. Silakan coba lagi.");
        }
    });
</script>
