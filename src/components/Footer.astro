---
const { settings } = Astro.props;
---
<footer class="py-12 px-4 bg-stone-950 text-stone-400 text-center border-t border-gold/20">
    <div class="max-w-lg mx-auto reveal">
        <h2 class="font-script text-4xl text-gold-light mb-4">{settings.groom_name_short} & {settings.bride_name_short}</h2>
        <p class="font-cinzel text-xs uppercase tracking-widest text-stone-300 mb-6">Terima Kasih atas Kehadiran & Doa Restu Anda</p>
        <div class="w-16 h-[1px] bg-gold/30 mx-auto mb-6"></div>
        <p class="text-[11px] text-stone-500"> Designed by {settings.bride_name_short} & {settings.groom_name_short} (and a little help from our sugar gliders & hamsters 🐾)</p>
    </div>
</footer>
