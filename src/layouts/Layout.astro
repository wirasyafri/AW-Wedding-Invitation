---
import '../styles/global.css';

import { supabase } from '../lib/supabase';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;

let activeTitle = title;
let activeDescription = description;

if (!activeTitle || !activeDescription) {
  let settings: any = null;
  try {
    const { data } = await supabase
      .from('settings')
      .select('groom_name_short, bride_name_short, groom_name_full, bride_name_full')
      .eq('id', 1)
      .single();
    if (data) {
      settings = data;
    }
  } catch (e) {
    console.error("Layout failed to fetch fallback names:", e);
  }

  const groomShort = settings?.groom_name_short || 'Wira';
  const brideShort = settings?.bride_name_short || 'Ayu';
  const groomFull = settings?.groom_name_full || 'Syafri Wira Wicaksana S.Tr.Kom, M.Kom';
  const brideFull = settings?.bride_name_full || 'Barqhadini Ayuningsih, S.T., M.T';

  if (!activeTitle) {
    activeTitle = `The Wedding of ${groomShort} & ${brideShort}`;
  }
  if (!activeDescription) {
    activeDescription = `Undangan Pernikahan Suci ${groomFull} & ${brideFull} - Selasa, 5 Januari 2027`;
  }
}
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{activeTitle}</title>
		<meta name="description" content={activeDescription} />
		<meta property="og:title" content={activeTitle} />
		<meta property="og:description" content={activeDescription} />
		<meta property="og:type" content="website" />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
		
		<!-- FontAwesome Icons -->
		<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js" defer></script>
	</head>
	<body class="bg-royal-cream font-sans text-stone-800 antialiased overflow-x-hidden selection:bg-gold/30 selection:text-gold-dark">
		<slot />

		<script>
			// Intersection Observer for scroll reveal animations
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('reveal-active');
					}
				});
			}, {
				threshold: 0.05,
				rootMargin: "0px 0px -50px 0px"
			});

			// Select and observe all elements with .reveal class
			document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
		</script>
	</body>
</html>
