                                                    {wish.voice_url && (
                                                        <button 
                                                            class="admin-voice-play-btn w-6 h-6 rounded-full bg-gold/10 hover:bg-gold/25 text-gold border border-gold/30 flex items-center justify-center transition cursor-pointer active:scale-90"
                                                            data-voice-url={wish.voice_url}
                                                            title="Putar Pesan Suara"
                                                        >
                                                            <i class="fa-solid fa-play text-[8px] translate-x-px"></i>
                                                        </button>
                                                    )}
                                                </div>
                                            </td>
                                            <td class="py-4 px-6 text-center">
                                                <span class={`px-2 py-0.5 rounded text-[10px] border ${
                                                    wish.status === 'Hadir' 
                                                        ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' 
                                                        : 'bg-amber-500/10 text-amber-400 border-amber-500/20'
                                                }`}>
                                                    {wish.status}
                                                </span>
                                            </td>
                                                                            <td class="py-4 px-6 text-center font-mono text-stone-400">{wish.guests || '1 Orang'}</td>
                                            <td class="py-4 px-6 text-stone-300 max-w-xs truncate" title={wish.message || 'Pesan Suara (Voice-Only)'}>
                                                {wish.message ? wish.message : (
                                                    <span class="text-stone-500 italic flex items-center gap-1">
                                                        <i class="fa-solid fa-volume-high text-[10px] text-gold/60"></i> Pesan Suara (Voice-Only)
                                                    </span>
                                                )}
                                            </td>
                                            <td class="py-4 px-6 text-center font-mono text-rose-400">
                                                {!String(wish.id).startsWith('voice_') ? (
                                                    <span><i class="fa-solid fa-heart text-[10px] mr-1"></i> {wish.likes || 0}</span>
                                                ) : (
                                                    <span class="text-stone-600">-</span>
                                                )}
                                            </td>
                                            <td class="py-4 px-6 text-center">
                                                <div class="inline-flex gap-2">
                                                    {!String(wish.id).startsWith('voice_') && (
                                                        <button 
                                                            data-wish-id={wish.id}
                                                            class={`wish-toggle-btn px-3 py-1.5 rounded text-[10px] font-cinzel tracking-wider uppercase font-bold cursor-pointer transition ${
                                                                wish.is_visible 
                                                                    ? 'bg-stone-800 text-stone-400 hover:bg-amber-600 hover:text-stone-950' 
                                                                    : 'bg-amber-50 text-stone-950 hover:bg-amber-400'
                                                            }`}
