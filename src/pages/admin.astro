                                    <span class="text-2xl font-bold text-gold-light font-mono">{cameraPhotos.length}</span>
                                    <span class="text-[10px] text-stone-500">foto dari tamu</span>
                                </div>
                                <div class="w-full bg-stone-900 rounded-full h-2 overflow-hidden border border-stone-800">
                                    <div class="bg-gold-light h-full rounded-full transition-all duration-500" style={{ width: `${Math.min((cameraPhotos.length / 100) * 100, 100)}%` }}></div>
                                </div>
                                <div class="flex justify-between text-[9px] text-stone-500 mt-1.5 font-mono">
                                    <span>Batas: {activeSettings.camera_photo_limit} foto / tamu</span>
                                    <span>Hapus: {activeSettings.camera_delete_limit} / tamu</span>
