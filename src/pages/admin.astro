                                                            </a>
                                                            <button 
                                                                class="admin-photo-delete-btn absolute top-2 right-2 z-20 w-7 h-7 bg-red-950/80 hover:bg-red-600 border border-red-900/40 text-red-400 hover:text-white rounded-full flex items-center justify-center transition-all cursor-pointer shadow-md opacity-0 group-hover:opacity-100"
                                                                data-photo-id={photo.id}
                                                                title="Hapus Foto Secara Permanen"
                                                            >
                                                                <i class="fa-solid fa-trash-can text-[10px]"></i>
                                                            </button>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            )}
                        </div>
                    </div>
                </div>

                {/* Master Action Form */}
                <form id="action-form" method="POST" style="display:none;">
                    <input type="hidden" name="password" value={passwordVal} />
                    <input type="hidden" name="action" id="action-type" />
                    <input type="hidden" name="wishId" id="action-id" />
                </form>
            </div>
        )}

        <footer class="text-center text-[10px] text-stone-700 font-cinzel mt-12 uppercase tracking-widest">
            AW Wedding Invitation Dashboard Panel
        </footer>
    </div>

    {/* Toast notification component for admin success feedbacks */}
    <div id="admin-toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-gold text-stone-950 font-cinzel text-xs font-bold py-3 px-6 rounded-lg shadow-2xl opacity-0 transform translate-y-0 transition-all duration-300 z-50 pointer-events-none">
        Pengaturan berhasil disimpan!
    </div>
</Layout>

<script is:inline>
    // Tab toggle logic
    const btnWishes = document.getElementById('tab-wishes');
    const btnSettings = document.getElementById('tab-settings');
    const btnCamera = document.getElementById('tab-camera');
    const viewWishes = document.getElementById('view-wishes');
    const viewSettings = document.getElementById('view-settings');
    const viewCamera = document.getElementById('view-camera');

    const tabs = [
        { btn: btnWishes, view: viewWishes },
        { btn: btnSettings, view: viewSettings },
        { btn: btnCamera, view: viewCamera }
    ];

    tabs.forEach(tab => {
        tab.btn?.addEventListener('click', () => {
            tabs.forEach(t => {
                t.btn?.classList.remove('border-gold', 'text-gold');
                t.btn?.classList.add('border-transparent', 'text-stone-400');
                t.view?.classList.add('hidden');
            });
            tab.btn.classList.add('border-gold', 'text-gold');
            tab.btn.classList.remove('border-transparent', 'text-stone-400');
            tab.view?.classList.remove('hidden');
        });
    });

    // Client-side helper function to submit moderation actions
    function performAction(action, id) {
        const actionType = document.getElementById('action-type');
        const actionId = document.getElementById('action-id');
        const form = document.getElementById('action-form');
        
        if (actionType && actionId && form) {
            actionType.value = action;
            actionId.value = id;
            form.submit();
        }
    }

    // Toggle wish visibility action handler
    document.querySelectorAll('.wish-toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-wish-id');
            performAction('toggle', id);
        });
    });

    // Delete wish action handler
    document.querySelectorAll('.wish-delete-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-wish-id');
            const name = btn.getAttribute('data-wish-name') || 'tamu';
            if (confirm(`Hapus ucapan dari ${name}?`)) {
                performAction('delete', id);
            }
        });
    });

    // Radio button input toggle logic
    const setupImageToggle = (radioName, urlWrapperId, fileWrapperId) => {
        const radios = document.getElementsByName(radioName);
        const urlWrapper = document.getElementById(urlWrapperId);
        const fileWrapper = document.getElementById(fileWrapperId);

        radios.forEach(radio => {
            radio.addEventListener('change', (e) => {
                if (e.target.value === 'url') {
                    urlWrapper?.classList.remove('hidden');
                    fileWrapper?.classList.add('hidden');
                } else {
                    urlWrapper?.classList.add('hidden');
                    fileWrapper?.classList.remove('hidden');
                }
            });
        });
    };

    setupImageToggle('groom_photo_type', 'groom_photo_url_wrapper', 'groom_photo_file_wrapper');
    setupImageToggle('bride_photo_type', 'bride_photo_url_wrapper', 'bride_photo_file_wrapper');
    setupImageToggle('hero_bg_type', 'hero_bg_url_wrapper', 'hero_bg_file_wrapper');

    // Update preview helper
    const updatePreview = (inputId, previewId) => {
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);
        if (input && preview) {
            preview.src = input.value;
            preview.style.display = input.value ? 'block' : 'none';
            if (preview.nextElementSibling) {
                preview.nextElementSibling.style.display = input.value ? 'none' : 'flex';
            }
        }
    };

    // Trigger preview update when URL inputs change
    document.getElementById('groom_photo')?.addEventListener('input', () => updatePreview('groom_photo', 'groom_photo_preview'));
    document.getElementById('bride_photo')?.addEventListener('input', () => updatePreview('bride_photo', 'bride_photo_preview'));
    document.getElementById('hero_bg')?.addEventListener('input', () => updatePreview('hero_bg', 'hero_bg_preview'));

    // Handle image file uploads to Supabase Storage via backend upload API
    const handleFileUpload = async (fileInputId, textInputId) => {
        const fileInput = document.getElementById(fileInputId);
        const textInput = document.getElementById(textInputId);
        if (!fileInput || !fileInput.files || fileInput.files.length === 0 || !textInput) return;

        const file = fileInput.files[0];
        const originalVal = textInput.value;
        textInput.value = "Mengunggah berkas...";

        try {
            const fileExt = file.name.split('.').pop();
            const fileName = `${Date.now()}_${Math.random().toString(36).substring(2, 9)}.${fileExt}`;
            
            const formData = new FormData();
            formData.append('file', file);
            formData.append('fileName', fileName);
            formData.append('oldFileUrl', originalVal);
            const masterPass = document.getElementsByName('password')[0]?.value || '';
            formData.append('password', masterPass);

            const res = await fetch('/api/upload', {
                method: 'POST',
                body: formData
            });

            if (res.ok) {
                const result = await res.json();
                textInput.value = result.publicUrl;
                
                // Update the preview immediately
                const previewId = textInputId + '_preview';
                updatePreview(textInputId, previewId);

                triggerAdminToast("Berkas foto berhasil diunggah! Klik Simpan di bawah untuk menyimpan.");
            } else {
                const err = await res.json();
                alert("Gagal mengunggah: " + (err.error || "Kesalahan server"));
                textInput.value = originalVal;
            }
        } catch (e) {
            console.error(e);
            alert("Gagal mengunggah foto. Pastikan Anda telah membuat storage bucket 'photos' di Supabase.");
            textInput.value = originalVal;
        }
    };

    document.getElementById('groom_photo_file')?.addEventListener('change', () => handleFileUpload('groom_photo_file', 'groom_photo'));
    document.getElementById('bride_photo_file')?.addEventListener('change', () => handleFileUpload('bride_photo_file', 'bride_photo'));
    document.getElementById('hero_bg_file')?.addEventListener('change', () => handleFileUpload('hero_bg_file', 'hero_bg'));

    // Client-side settings form handler
    const settingsForm = document.getElementById('settings-form');
    settingsForm?.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Collect form data
        const formData = new FormData(settingsForm);
        const data = {};
        formData.forEach((val, key) => {
            data[key] = val;
        });

        // Helper to convert picker datetime-local value to ISO UTC string
        const convertToUtcIso = (localVal) => {
            if (!localVal) return '';
            try {
                const d = new Date(localVal);
                if (isNaN(d.getTime())) return '';
                return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
            } catch (err) {
                return '';
            }
        };

        if (data['countdown_target_date']) {
            try {
                const d = new Date(data['countdown_target_date']);
                if (!isNaN(d.getTime())) {
                    data['countdown_target_date'] = d.toISOString();
                } else {
                    data['countdown_target_date'] = '';
                }
            } catch (err) {
                data['countdown_target_date'] = '';
            }
        }
        if (data['akad_start_iso']) {
            data['akad_start_iso'] = convertToUtcIso(data['akad_start_iso']);
        }
        if (data['akad_end_iso']) {
            data['akad_end_iso'] = convertToUtcIso(data['akad_end_iso']);
        }
        if (data['resepsi_start_iso']) {
            data['resepsi_start_iso'] = convertToUtcIso(data['resepsi_start_iso']);
        }
        if (data['resepsi_end_iso']) {
            data['resepsi_end_iso'] = convertToUtcIso(data['resepsi_end_iso']);
        }

        // Add the password from the master action form
        const masterPass = document.getElementsByName('password')[0]?.value || '';
        data['password'] = masterPass;

        // Show loading status
        const submitBtn = settingsForm.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.innerText = "MENYIMPAN...";

        try {
            const res = await fetch('/api/save-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (res.ok) {
                triggerAdminToast("Pengaturan berhasil disimpan!");
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } else {
                const err = await res.json();
                alert("Gagal menyimpan: " + (err.error || "Kesalahan server"));
            }
        } catch (err) {
            console.error(err);
            alert("Gagal terhubung ke server.");
        } finally {
            if (submitBtn) submitBtn.innerText = "SIMPAN PENGATURAN UNDANGAN";
        }
    });

    function triggerAdminToast(text) {
        const toast = document.getElementById('admin-toast');
        if (toast) {
            toast.innerText = text;
            toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, -20px)';
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, 0)';
            }, 3000);
        }
    }

    // Automatically trigger browser's calendar/time picker popup when clicking anywhere in the input
    document.querySelectorAll('input[type="datetime-local"]').forEach(input => {
        input.addEventListener('click', () => {
            try {
                input.showPicker();
            } catch (err) {
                console.warn('showPicker not supported on this browser:', err);
            }
        });
    });

    // Client-side dynamic refresh for disposable camera photos
    const refreshCameraBtn = document.getElementById('refresh-camera-btn');
    const cameraPhotosContainer = document.getElementById('camera-photos-container');

    refreshCameraBtn?.addEventListener('click', async () => {
        const originalText = refreshCameraBtn.innerHTML;
        refreshCameraBtn.disabled = true;
        refreshCameraBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memuat...';

        try {
            const masterPass = document.getElementsByName('password')[0]?.value || '';
            const res = await fetch(`/api/camera?adminPass=${encodeURIComponent(masterPass)}`);
            if (res.ok) {
                const photos = await res.json();
                
                // Group photos by guest
                const groups = {};
                photos.forEach(photo => {
                    const guest = photo.guest_id || 'Tamu Tanpa Nama';
                    if (!groups[guest]) {
                        groups[guest] = [];
                    }
                    groups[guest].push(photo);
                });

                if (Object.keys(groups).length === 0) {
                    cameraPhotosContainer.innerHTML = `
                        <div class="py-12 text-center text-stone-500 font-cinzel">
                            Belum ada foto yang diambil oleh tamu.
                        </div>
                    `;
                } else {
                    let html = '<div class="space-y-8">';
                    Object.entries(groups).forEach(([guestName, guestPhotos]) => {
                        html += `
                            <div class="border border-stone-800/60 bg-stone-950/40 rounded-xl p-5 space-y-4">
                                <div class="flex items-center justify-between border-b border-stone-800 pb-2">
                                    <div class="flex items-center gap-2">
                                        <div class="w-2 h-2 rounded-full bg-gold"></div>
                                        <h3 class="font-cinzel text-sm text-stone-200 font-bold tracking-wide">${guestName}</h3>
                                    </div>
                                    <span class="text-[10px] text-stone-500 font-mono">${guestPhotos.length} Foto</span>
                                </div>
                                <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-4">
                        `;
                        guestPhotos.forEach(photo => {
                            html += `
                                    <div class="group relative aspect-square bg-stone-900 border border-stone-800 rounded-lg overflow-hidden shadow-lg hover:scale-[1.03] transition-all" data-photo-card-id="${photo.id}">
                                        <img src="${photo.url}" class="w-full h-full object-cover" alt="Foto dari ${guestName}" loading="lazy" />
                                        <a 
                                            href="${photo.url}" 
                                            target="_blank" 
                                            rel="noopener noreferrer" 
                                            class="absolute inset-0 bg-stone-950/60 opacity-0 group-hover:opacity-100 flex items-center justify-center text-stone-200 text-xs font-cinzel uppercase tracking-wider transition-opacity duration-200"
                                        >
                                            Buka Foto
                                        </a>
                                        <button 
                                            class="admin-photo-delete-btn absolute top-2 right-2 z-20 w-7 h-7 bg-red-950/80 hover:bg-red-650 border border-red-900/40 text-red-400 hover:text-white rounded-full flex items-center justify-center transition-all cursor-pointer shadow-md opacity-0 group-hover:opacity-100"
                                            data-photo-id="${photo.id}"
                                            title="Hapus Foto Secara Permanen"
                                        >
                                            <i class="fa-solid fa-trash-can text-[10px]"></i>
                                        </button>
                                    </div>
                            `;
                        });
                        html += `
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                    cameraPhotosContainer.innerHTML = html;
                }
                
                triggerAdminToast("Daftar foto berhasil diperbarui!");
            } else {
                const err = await res.json();
                alert("Gagal memperbarui: " + (err.error || "Kesalahan server"));
            }
        } catch (e) {
            console.error(e);
            alert("Kesalahan koneksi saat memperbarui foto.");
        } finally {
            refreshCameraBtn.disabled = false;
            refreshCameraBtn.innerHTML = originalText;
        }
    });

    // Delete photo click listener delegation
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.admin-photo-delete-btn');
        if (!btn) return;
        
        const photoId = btn.getAttribute('data-photo-id');
        if (!photoId) return;

        if (!confirm('Hapus foto ini secara permanen dari server database dan storage?')) {
            return;
        }

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-[9px]"></i>';

        try {
            const masterPass = document.getElementsByName('password')[0]?.value || '';
            const res = await fetch(`/api/camera?id=${photoId}&adminPass=${encodeURIComponent(masterPass)}`, {
                method: 'DELETE'
            });

            if (res.ok) {
                const card = document.querySelector(`[data-photo-card-id="${photoId}"]`);
                if (card) {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.8)';
                    setTimeout(() => {
                        card.remove();
                        // Refresh container to regroup and recount photos
                        refreshCameraBtn?.click();
                    }, 300);
                }
                triggerAdminToast("Foto berhasil dihapus secara permanen!");
            } else {
                const err = await res.json();
                alert("Gagal menghapus: " + (err.error || "Kesalahan server"));
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        } catch (err) {
            console.error(err);
            alert("Kesalahan koneksi saat menghapus foto.");
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });

    // Admin Voice Playback logic
    let adminPlayingAudio = null;
    let adminPlayingBtn = null;

    document.querySelectorAll('.admin-voice-play-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const url = btn.getAttribute('data-voice-url');
            if (!url) return;

            if (adminPlayingBtn === btn) {
                if (adminPlayingAudio.paused) {
                    adminPlayingAudio.play();
                    btn.innerHTML = '<i class="fa-solid fa-pause text-[8px]"></i>';
                } else {
                    adminPlayingAudio.pause();
                    btn.innerHTML = '<i class="fa-solid fa-play text-[8px] translate-x-px"></i>';
                }
                return;
            }

            if (adminPlayingAudio) {
                adminPlayingAudio.pause();
                if (adminPlayingBtn) {
                    adminPlayingBtn.innerHTML = '<i class="fa-solid fa-play text-[8px] translate-x-px"></i>';
                }
            }

            adminPlayingAudio = new Audio(url);
            adminPlayingBtn = btn;
            adminPlayingAudio.play();
            btn.innerHTML = '<i class="fa-solid fa-pause text-[8px]"></i>';

            adminPlayingAudio.addEventListener('ended', () => {
                btn.innerHTML = '<i class="fa-solid fa-play text-[8px] translate-x-px"></i>';
                adminPlayingAudio = null;
                adminPlayingBtn = null;
            });
        });
    });
</script>
