                        </div>
                        <div class="bg-stone-900 border border-stone-800 rounded-xl p-5 shadow-xl text-center">
                            <span class="text-stone-300 font-cinzel text-[10px] uppercase tracking-wider block mb-1">Total Estimasi Tamu</span>
