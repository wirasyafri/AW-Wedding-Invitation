                                <i class="fa-solid fa-arrows-rotate"></i> Perbarui Statistik
                            </button>
                        </div>

                        {/* Top row cards */}
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
