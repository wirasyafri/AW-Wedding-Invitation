                                </div>
                                <div class="w-full bg-stone-900 rounded-full h-2 overflow-hidden border border-stone-800 flex">
                                    <div id="bar-rsvp-attending" class="bg-emerald-500 h-full transition-all duration-500" style={{ width: `${pctAttending}%` }} title={`Hadir: ${pctAttending.toFixed(1)}%`}></div>
                                    <div id="bar-rsvp-notattending" class="bg-red-500 h-full transition-all duration-500" style={{ width: `${pctNotAttending}%` }} title={`Tidak Hadir: ${pctNotAttending.toFixed(1)}%`}></div>
                                    <div id="bar-rsvp-tentative" class="bg-amber-500 h-full transition-all duration-500" style={{ width: `${pctTentative}%` }} title={`Ragu-ragu: ${pctTentative.toFixed(1)}%`}></div>
