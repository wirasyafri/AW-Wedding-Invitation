                                    <span id="txt-rsvp-total">{rsvpCount} respon</span>
                                </div>
                            </div>
                        </div>

                        {/* Storage details & Database counts */}
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
                            {/* Storage Buckets details */}
                            <div class="border border-stone-800/60 bg-stone-950/40 rounded-xl p-5 space-y-4">
                                <div class="flex items-center gap-2 border-b border-stone-800 pb-2">
                                    <div class="w-2 h-2 rounded-full bg-gold"></div>
                                    <h3 class="font-cinzel text-xs text-stone-200 font-bold tracking-wide">Rincian Storage Bucket</h3>
                                </div>
                                <div class="space-y-4 text-xs">
                                    <div class="flex items-center justify-between border-b border-stone-900 pb-2">
                                        <div>
                                            <span class="text-stone-300 font-mono block">disposable-camera</span>
                                            <span class="text-[10px] text-stone-500">Foto kamera & rekaman suara tamu</span>
                                        </div>
                                        <div class="text-right">
                                            <span id="bucket-camera-size" class="text-stone-200 font-bold font-mono block">{formatBytes(cameraStorageStats.totalSize)}</span>
                                            <span id="bucket-camera-count" class="text-[10px] text-stone-500 font-mono">{cameraStorageStats.fileCount} file</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between border-b border-stone-900 pb-2">
                                        <div>
                                            <span class="text-stone-300 font-mono block">photos</span>
                                            <span class="text-[10px] text-stone-500">Aset foto mempelai & latar belakang</span>
                                        </div>
                                        <div class="text-right">
                                            <span id="bucket-photos-size" class="text-stone-200 font-bold font-mono block">{formatBytes(photosStorageStats.totalSize)}</span>
                                            <span id="bucket-photos-count" class="text-[10px] text-stone-500 font-mono">{photosStorageStats.fileCount} file</span>
