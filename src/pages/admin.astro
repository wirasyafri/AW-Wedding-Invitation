                                        <span>Status bucket: Publik (Public Read)</span>
                                        <span>Kebijakan RLS: Proteksi Tulis & Hapus Aktif</span>
                                    </div>
                                </div>
                            </div>

                            {/* Database Table details */}
                            <div class="border border-stone-800/60 bg-stone-950/40 rounded-xl p-5 space-y-4">
                                <div class="flex items-center gap-2 border-b border-stone-800 pb-2">
                                    <div class="w-2 h-2 rounded-full bg-gold"></div>
                                    <h3 class="font-cinzel text-xs text-stone-200 font-bold tracking-wide">Rincian Baris Tabel Basis Data</h3>
                                </div>
                                <div class="overflow-x-auto text-xs">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr class="border-b border-stone-850 text-stone-500 font-mono text-[9px] uppercase tracking-wider">
                                                <th class="py-2">Nama Tabel</th>
                                                <th class="py-2">Deskripsi</th>
                                                <th class="py-2 text-right">Jumlah Baris</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-stone-900 font-mono text-stone-300">
