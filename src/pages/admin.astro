                                            </tr>
                                            <tr>
                                                <td class="py-2 text-stone-400">guest_voices</td>
                                                <td class="py-2 text-[10px] text-stone-500 font-sans">Rekaman suara ucapan tamu</td>
                                                <td id="tbl-row-voices" class="py-2 text-right text-stone-200">{guestVoicesMap.size}</td>
                                            </tr>
                                            <tr>
                                                <td class="py-2 text-stone-400">camera_photos</td>
                                                <td class="py-2 text-[10px] text-stone-500 font-sans">Daftar foto kamera disposable</td>
                                                <td id="tbl-row-photos" class="py-2 text-right text-stone-200">{cameraPhotos.length}</td>
                                            </tr>
                                            <tr>
                                                <td class="py-2 text-stone-400">camera_deletions</td>
                                                <td class="py-2 text-[10px] text-stone-500 font-sans">Log penghapusan foto tamu</td>
                                                <td id="tbl-row-deletions" class="py-2 text-right text-stone-200">{cameraDeletionsCount}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        {/* File lists section */}
                        <div class="border border-stone-800/60 bg-stone-950/20 rounded-xl p-5 space-y-4">
                            <div class="flex items-center justify-between border-b border-stone-800 pb-2">
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 rounded-full bg-gold"></div>
                                    <h3 class="font-cinzel text-xs text-stone-200 font-bold tracking-wide">Daftar Berkas Penyimpanan (Storage)</h3>
                                </div>
                                <span id="lbl-total-files-count" class="text-[10px] text-stone-500 font-mono">{totalStorageFiles} Berkas Terdeteksi</span>
                            </div>

                            <div class="max-h-96 overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-stone-800">
                                <table class="w-full text-left border-collapse text-xs">
                                    <thead>
                                        <tr class="border-b border-stone-850 text-stone-500 font-mono text-[9px] uppercase tracking-wider sticky top-0 bg-stone-900/90 backdrop-blur z-10">
                                            <th class="py-2.5 px-2">Bucket</th>
                                            <th class="py-2.5 px-2">Path / Nama Berkas</th>
                                            <th class="py-2.5 px-2 text-right">Ukuran</th>
                                            <th class="py-2.5 px-2 text-center">Aksi</th>
                                        </tr>
                                    </thead>
                                    <tbody id="files-list-body" class="divide-y divide-stone-900 text-stone-300 font-mono">
                                        {[
                                            ...cameraStorageStats.fileList.map(f => ({ ...f, bucket: 'disposable-camera' })),
                                            ...photosStorageStats.fileList.map(f => ({ ...f, bucket: 'photos' }))
                                        ].sort((a,b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime()).map(file => {
                                            const publicUrl = supabase.storage.from(file.bucket).getPublicUrl(file.name).data.publicUrl;
                                            
                                            // Determine if file is orphan
                                            let isOrphan = false;
                                            if (file.bucket === 'disposable-camera') {
                                                isOrphan = !activeDbUrls.has(publicUrl);
                                            } else if (file.bucket === 'photos') {
                                                isOrphan = !activeSettingsUrls.has(publicUrl) && !activeSettingsUrls.has('/' + file.name) && !activeSettingsUrls.has(file.name);
                                            }

                                            const isLarge = file.size > 3 * 1024 * 1024; // >3MB
                                            const isAudio = file.name.endsWith('.mp3') || file.name.endsWith('.wav') || file.name.includes('/voices/');
                                            
                                            return (
                                                <tr class="hover:bg-stone-900/40 transition" data-file-row-bucket={file.bucket} data-file-row-name={file.name}>
                                                    <td class="py-2 px-2 text-gold/80 text-[10px]">{file.bucket}</td>
                                                    <td class="py-2 px-2 font-sans text-stone-200" title={file.name}>
                                                        <div class="flex flex-wrap items-center gap-1.5">
                                                            <span class="truncate max-w-[200px] sm:max-w-xs">{file.name}</span>
                                                            {isOrphan && (
                                                                <span class="px-1.5 py-0.5 bg-red-950/80 text-red-400 border border-red-900/40 text-[8px] font-bold uppercase rounded font-mono select-none" title="Berkas ini tidak terhubung dengan ucapan atau pengaturan undangan. Aman untuk dihapus.">Orphan</span>
                                                            )}
                                                            {isLarge && (
                                                                <span class="px-1.5 py-0.5 bg-amber-950/80 text-amber-400 border border-amber-900/40 text-[8px] font-bold uppercase rounded font-mono select-none" title="Berkas berukuran besar (> 3MB) yang memakan kuota penyimpanan.">Besar</span>
                                                            )}
                                                        </div>
                                                    </td>
                                                    <td class="py-2 px-2 text-right text-stone-300">{formatBytes(file.size)}</td>
                                                    <td class="py-2 px-2 text-center">
                                                        <div class="flex items-center justify-center gap-1.5">
                                                            {isAudio && (
                                                                <button 
                                                                    class="admin-voice-play-btn w-6 h-6 rounded bg-stone-950 hover:bg-gold/20 text-stone-400 hover:text-gold border border-stone-850 hover:border-gold/30 flex items-center justify-center transition cursor-pointer active:scale-90"
                                                                    data-voice-url={publicUrl}
                                                                    title="Putar Rekaman Suara"
                                                                >
                                                                    <i class="fa-solid fa-play text-[8px] translate-x-px"></i>
                                                                </button>
                                                            )}
                                                            
                                                            <a 
                                                                href={publicUrl} 
                                                                target="_blank" 
                                                                rel="noopener noreferrer" 
                                                                class="inline-flex items-center justify-center w-6 h-6 rounded bg-stone-950 hover:bg-gold/20 text-stone-400 hover:text-gold border border-stone-850 hover:border-gold/30 transition cursor-pointer active:scale-95"
                                                                title="Lihat Berkas di Tab Baru"
                                                            >
                                                                <i class="fa-solid fa-up-right-from-square text-[9px]"></i>
                                                            </a>

                                                            {isOrphan && (
                                                                <button 
                                                                    class="admin-file-delete-btn w-6 h-6 rounded bg-red-950/45 hover:bg-red-900/80 text-red-400 hover:text-white border border-red-900/40 hover:border-red-650 flex items-center justify-center transition cursor-pointer active:scale-90"
                                                                    data-file-bucket={file.bucket}
                                                                    data-file-path={file.name}
                                                                    title="Hapus Berkas dari Storage secara Permanen"
                                                                >
                                                                    <i class="fa-solid fa-trash-can text-[9px]"></i>
                                                                </button>
                                                            )}
                                                        </div>
                                                    </td>
                                                </tr>
                                            );
                                        })}
                                        {totalStorageFiles === 0 && (
                                            <tr id="files-list-empty">
                                                <td colspan="4" class="py-8 text-center text-stone-500 font-cinzel">Tidak ada berkas yang tersimpan di storage.</td>
                                            </tr>
                                        )}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        {/* Safety Activity Logs Section */}
                        <div class="border border-stone-800/60 bg-stone-950/20 rounded-xl p-5 space-y-4 mt-8">
                            <div class="flex items-center justify-between border-b border-stone-800 pb-2">
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 rounded-full bg-red-500"></div>
                                    <h3 class="font-cinzel text-xs text-stone-200 font-bold tracking-wide">Audit Log Penghapusan Kamera (Safety Logs)</h3>
                                </div>
                                <button id="clear-logs-btn" class="px-3 py-1.5 bg-red-950/20 hover:bg-red-900/80 border border-red-900/40 hover:border-red-650 font-cinzel text-[9px] text-red-400 hover:text-white rounded transition cursor-pointer flex items-center gap-1">
                                    <i class="fa-solid fa-trash-can"></i> Bersihkan Log
                                </button>
                            </div>

                            <div class="max-h-72 overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-stone-800">
                                <table class="w-full text-left border-collapse text-xs">
                                    <thead>
                                        <tr class="border-b border-stone-850 text-stone-500 font-mono text-[9px] uppercase tracking-wider sticky top-0 bg-stone-900/90 backdrop-blur z-10">
                                            <th class="py-2 px-2">Tanggal / Waktu</th>
                                            <th class="py-2 px-2">Nama Tamu (Guest ID)</th>
                                            <th class="py-2 px-2">URL Foto Dihapus</th>
                                        </tr>
                                    </thead>
                                    <tbody id="logs-list-body" class="divide-y divide-stone-900 text-stone-300 font-mono">
                                        {cameraDeletions.map(log => (
                                            <tr class="hover:bg-stone-900/40 transition">
                                                <td class="py-2 px-2 text-[10px] text-stone-400">{new Date(log.deleted_at).toLocaleString('id-ID')}</td>
                                                <td class="py-2 px-2 text-stone-200 font-sans">{log.guest_id.split('#')[0]} {log.guest_id.includes('#') && <span class="text-[9px] text-stone-500 font-mono">#{log.guest_id.split('#')[1]}</span>}</td>
                                                <td class="py-2 px-2 truncate max-w-sm font-sans text-stone-400" title={log.photo_url}>
                                                    <a href={log.photo_url} target="_blank" rel="noopener noreferrer" class="hover:text-gold transition flex items-center gap-1.5">
                                                        <i class="fa-solid fa-up-right-from-square text-[8px]"></i> {log.photo_url.split('/').pop() || log.photo_url}
                                                    </a>
                                                </td>
                                            </tr>
                                        ))}
                                        {cameraDeletions.length === 0 && (
                                            <tr id="logs-list-empty">
                                                <td colspan="3" class="py-8 text-center text-stone-500 font-cinzel">Belum ada riwayat log penghapusan foto.</td>
                                            </tr>
                                        )}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                {/* Master Action Form */}
                <form id="action-form" method="POST" style="display:none;">
                    <input type="hidden" name="password" value={passwordVal} />
                    <input type="hidden" name="action" id="action-type" />
                    <input type="hidden" name="wishId" id="action-id" />
                </form>
            </div>
        )}

        <footer class="text-center text-[10px] text-stone-700 font-cinzel mt-12 uppercase tracking-widest">
            AW Wedding Invitation Dashboard Panel
        </footer>
    </div>

    {/* Image Cropper & Zoom Modal */}
    <div id="cropper-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/85 backdrop-blur-sm p-4">
        <div class="bg-stone-900 border border-stone-800 rounded-2xl w-full max-w-sm p-5 shadow-2xl flex flex-col items-center space-y-5 animate-scale-up">
            <div class="w-full text-center">
                <h3 id="cropper-modal-title" class="font-cinzel text-xs text-gold uppercase tracking-wider font-bold">Sesuaikan Foto</h3>
                <p class="text-stone-500 text-[9px] uppercase tracking-widest mt-1.5 leading-relaxed">Geser foto untuk memotong, geser slider untuk zoom</p>
            </div>

            {/* Viewport container */}
            <div class="relative flex items-center justify-center w-full h-52 bg-stone-950/40 border border-stone-850 rounded-xl overflow-hidden">
                {/* Dynamically styled viewport circle (Groom/Bride) or rectangle (Hero BG) */}
                <div id="cropper-viewport" class="relative overflow-hidden border border-gold/40 shadow-inner w-40 h-40 rounded-full">
                    <img id="cropper-image" class="w-full h-full object-cover pointer-events-none" src="" style="object-position: center; transform: scale(1.0);" />
                </div>
                {/* Grab/drag overlay */}
                <div id="cropper-grab-overlay" class="absolute inset-0 cursor-grab active:cursor-grabbing z-10 flex items-center justify-center touch-none" style="touch-action: none;">
                    <div id="cropper-guidelines" class="absolute inset-0 border border-dashed border-stone-500/20 pointer-events-none rounded-[inherit] w-40 h-40"></div>
                </div>
            </div>

            {/* Zoom Slider */}
            <div class="w-full space-y-2">
                <div class="flex justify-between items-center text-[8px] text-stone-400 font-mono uppercase tracking-wider">
                    <span>1.0x</span>
                    <span id="cropper-zoom-label">Zoom: 1.00x</span>
                    <span>3.0x</span>
                </div>
                <input 
                    type="range" 
                    id="cropper-zoom-slider" 
                    min="1" 
                    max="3" 
                    step="0.01" 
                    value="1.00" 
                    class="w-full accent-gold bg-stone-800 h-1 rounded-lg appearance-none cursor-pointer" 
                />
            </div>

            {/* Action buttons */}
            <div class="w-full flex gap-3 pt-1">
                <button 
                    type="button"
                    id="cropper-cancel-btn" 
                    class="flex-1 py-2 bg-stone-950 hover:bg-stone-900 border border-stone-850 text-stone-400 hover:text-stone-200 text-xs font-cinzel rounded-lg transition active:scale-95 cursor-pointer focus:outline-none"
                >
                    Batal
                </button>
                <button 
                    type="button"
                    id="cropper-save-btn" 
                    class="flex-1 py-2 bg-gold hover:bg-gold-light text-stone-950 font-bold text-xs font-cinzel rounded-lg transition active:scale-95 cursor-pointer shadow-lg focus:outline-none"
                >
                    Terapkan
                </button>
            </div>
        </div>
    </div>

    {/* Toast notification component for admin success feedbacks */}
    <div id="admin-toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-gold text-stone-950 font-cinzel text-xs font-bold py-3 px-6 rounded-lg shadow-2xl opacity-0 transform translate-y-0 transition-all duration-300 z-50 pointer-events-none">
        Pengaturan berhasil disimpan!
    </div>
</Layout>

<script is:inline>
    // Tab toggle logic
    const btnWishes = document.getElementById('tab-wishes');
    const btnSettings = document.getElementById('tab-settings');
    const btnCamera = document.getElementById('tab-camera');
    const btnUsage = document.getElementById('tab-usage');
    const viewWishes = document.getElementById('view-wishes');
    const viewSettings = document.getElementById('view-settings');
    const viewCamera = document.getElementById('view-camera');
    const viewUsage = document.getElementById('view-usage');

    const tabs = [
        { btn: btnWishes, view: viewWishes },
        { btn: btnSettings, view: viewSettings },
        { btn: btnCamera, view: viewCamera },
        { btn: btnUsage, view: viewUsage }
    ];

    tabs.forEach(tab => {
        tab.btn?.addEventListener('click', () => {
            tabs.forEach(t => {
                t.btn?.classList.remove('border-gold', 'text-gold');
                t.btn?.classList.add('border-transparent', 'text-stone-400');
                t.view?.classList.add('hidden');
            });
            tab.btn.classList.add('border-gold', 'text-gold');
            tab.btn.classList.remove('border-transparent', 'text-stone-400');
            tab.view?.classList.remove('hidden');
        });
    });

    // Client-side helper function to submit moderation actions
    function performAction(action, id) {
        const actionType = document.getElementById('action-type');
        const actionId = document.getElementById('action-id');
        const form = document.getElementById('action-form');
        
        if (actionType && actionId && form) {
            actionType.value = action;
            actionId.value = id;
            form.submit();
        }
    }

    // Toggle wish visibility action handler
    document.querySelectorAll('.wish-toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-wish-id');
            performAction('toggle', id);
        });
    });

    // Delete wish action handler
    document.querySelectorAll('.wish-delete-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-wish-id');
            const name = btn.getAttribute('data-wish-name') || 'tamu';
            if (confirm(`Hapus ucapan dari ${name}?`)) {
                performAction('delete', id);
            }
        });
    });

    // Radio button input toggle logic
    const setupImageToggle = (radioName, urlWrapperId, fileWrapperId) => {
        const radios = document.getElementsByName(radioName);
        const urlWrapper = document.getElementById(urlWrapperId);
        const fileWrapper = document.getElementById(fileWrapperId);

        radios.forEach(radio => {
            radio.addEventListener('change', (e) => {
                if (e.target.value === 'url') {
                    urlWrapper?.classList.remove('hidden');
                    fileWrapper?.classList.add('hidden');
                } else {
                    urlWrapper?.classList.add('hidden');
                    fileWrapper?.classList.remove('hidden');
                }
            });
        });
    };

    setupImageToggle('groom_photo_type', 'groom_photo_url_wrapper', 'groom_photo_file_wrapper');
    setupImageToggle('bride_photo_type', 'bride_photo_url_wrapper', 'bride_photo_file_wrapper');
    setupImageToggle('hero_bg_type', 'hero_bg_url_wrapper', 'hero_bg_file_wrapper');

    // Client-side helper to retrieve position parameter from URL
    const getUrlPositionClient = (url) => {
        if (!url) return 'center';
        try {
            const match = url.match(/[\?&]pos=([^&]+)/);
            return match ? decodeURIComponent(match[1]) : 'center';
        } catch (e) {
            return 'center';
        }
    };

    // Client-side helper to retrieve zoom parameter from URL
    const getUrlZoomClient = (url) => {
        if (!url) return 1.0;
        try {
            const match = url.match(/[\?&]zoom=([^&]+)/);
            return match ? parseFloat(decodeURIComponent(match[1])) || 1.0 : 1.0;
        } catch (e) {
            return 1.0;
        }
    };

    // Client-side helper to update position and zoom parameters in URL
    const updateUrlParamsClient = (url, position, zoom) => {
        if (!url) return '';
        if (url === "Mengunggah berkas...") return url;
        try {
            let cleanUrl = url.replace(/[\?&]pos=[^&]+/g, '').replace(/[\?&]zoom=[^&]+/g, '');
            const hasQuery = cleanUrl.includes('?');
            const separator = hasQuery ? '&' : '?';
            return cleanUrl + separator + 'pos=' + encodeURIComponent(position) + '&zoom=' + encodeURIComponent(zoom);
        } catch (e) {
            return url;
        }
    };

    // Sync image URL, preview display, position and zoom style
    const syncImageParams = (inputId, previewId) => {
        const input = document.getElementById(inputId);
        const preview = document.getElementById(previewId);

        if (!input || !preview) return;

        const url = input.value;
        const position = getUrlPositionClient(url);
        const zoom = getUrlZoomClient(url);
        const cleanPos = position.replace('_', ' ');

        preview.src = url;
        preview.style.objectPosition = cleanPos;
        preview.style.transform = `scale(${zoom})`;
        preview.style.transformOrigin = cleanPos;
        preview.style.display = url ? 'block' : 'none';
        if (preview.nextElementSibling) {
            preview.nextElementSibling.style.display = url ? 'none' : 'flex';
        }
    };

    // Image Cropper Modal logic
    const cropperModal = document.getElementById('cropper-modal');
    const cropperTitle = document.getElementById('cropper-modal-title');
    const cropperViewport = document.getElementById('cropper-viewport');
    const cropperImage = document.getElementById('cropper-image');
    const cropperGrabOverlay = document.getElementById('cropper-grab-overlay');
    const cropperGuidelines = document.getElementById('cropper-guidelines');
    const cropperZoomSlider = document.getElementById('cropper-zoom-slider');
    const cropperZoomLabel = document.getElementById('cropper-zoom-label');
    const cropperCancelBtn = document.getElementById('cropper-cancel-btn');
    const cropperSaveBtn = document.getElementById('cropper-save-btn');

    let activeInputId = null;
    let activePreviewId = null;
    let currentPosPercent = { x: 50, y: 50 };
    let currentZoom = 1.0;

    // Parse X and Y percentage coordinates from position string
    const parsePositionPercent = (posStr) => {
        if (!posStr || posStr === 'center') return { x: 50, y: 50 };
        if (posStr === 'top') return { x: 50, y: 0 };
        if (posStr === 'bottom') return { x: 50, y: 100 };
        if (posStr === 'left') return { x: 0, y: 50 };
        if (posStr === 'right') return { x: 100, y: 50 };

        const cleanPos = posStr.replace('_', ' ');
        const parts = cleanPos.split(' ');
        if (parts.length === 2) {
            const x = parseFloat(parts[0]) || 50;
            const y = parseFloat(parts[1]) || 50;
            return { x, y };
        }
        return { x: 50, y: 50 };
    };

    const openCropperModal = (inputId, previewId, titleText, isRound = true) => {
        const input = document.getElementById(inputId);
        if (!input || !input.value) {
            alert("Harap masukkan atau unggah foto terlebih dahulu!");
            return;
        }

        activeInputId = inputId;
        activePreviewId = previewId;

        const url = input.value;
        const initialPos = getUrlPositionClient(url);
        currentPosPercent = parsePositionPercent(initialPos);
        currentZoom = getUrlZoomClient(url);

        // Populate Modal Title and Image
        if (cropperTitle) cropperTitle.innerText = titleText;
        if (cropperImage) {
            cropperImage.src = url;
            cropperImage.style.objectPosition = `${currentPosPercent.x}% ${currentPosPercent.y}%`;
            cropperImage.style.transform = `scale(${currentZoom})`;
            cropperImage.style.transformOrigin = `${currentPosPercent.x}% ${currentPosPercent.y}%`;
        }

        // Apply circular/rectangular styling to Modal Viewport
        if (cropperViewport && cropperGuidelines) {
            if (isRound) {
                cropperViewport.className = "relative overflow-hidden border border-gold/40 shadow-inner w-40 h-40 rounded-full";
                cropperGuidelines.className = "absolute inset-0 border border-dashed border-stone-500/20 pointer-events-none rounded-full w-40 h-40";
            } else {
                cropperViewport.className = "relative overflow-hidden border border-gold/40 shadow-inner w-72 h-40 rounded-lg";
                cropperGuidelines.className = "absolute inset-0 border border-dashed border-stone-500/20 pointer-events-none rounded-lg w-72 h-40";
            }
        }

        // Set zoom slider value
        if (cropperZoomSlider) {
            cropperZoomSlider.value = currentZoom.toFixed(2);
        }
        if (cropperZoomLabel) {
            cropperZoomLabel.innerText = `Zoom: ${currentZoom.toFixed(2)}x`;
        }

        // Show Modal overlay
        if (cropperModal) {
            cropperModal.classList.remove('hidden');
        }
    };

    const closeCropperModal = () => {
        if (cropperModal) {
            cropperModal.classList.add('hidden');
        }
        activeInputId = null;
        activePreviewId = null;
    };

    cropperCancelBtn?.addEventListener('click', closeCropperModal);

    cropperSaveBtn?.addEventListener('click', () => {
        if (!activeInputId || !activePreviewId) return;

        const input = document.getElementById(activeInputId);
        if (input) {
            const posStr = `${currentPosPercent.x}%_${currentPosPercent.y}%`;
            input.value = updateUrlParamsClient(input.value, posStr, currentZoom.toFixed(2));
            syncImageParams(activeInputId, activePreviewId);
        }
        closeCropperModal();
    });

    // Zoom slider change handler
    cropperZoomSlider?.addEventListener('input', (e) => {
        const val = parseFloat(e.target.value) || 1.0;
        currentZoom = val;
        if (cropperZoomLabel) {
            cropperZoomLabel.innerText = `Zoom: ${val.toFixed(2)}x`;
        }
        if (cropperImage) {
            cropperImage.style.transform = `scale(${val})`;
        }
    });

    // Drag-to-pan panning inside Modal Viewport
    let isDraggingModalImage = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragStartPercentX = 50;
    let dragStartPercentY = 50;

    const onDragStart = (e) => {
        if (e.type === 'mousedown' && e.button !== 0) return;
        isDraggingModalImage = true;

        const clientX = e.type === 'touchstart' ? e.touches[0].clientX : e.clientX;
        const clientY = e.type === 'touchstart' ? e.touches[0].clientY : e.clientY;

        dragStartX = clientX;
        dragStartY = clientY;

        dragStartPercentX = currentPosPercent.x;
        dragStartPercentY = currentPosPercent.y;
    };

    const onDragMove = (e) => {
        if (!isDraggingModalImage) return;

        const clientX = e.type === 'touchmove' ? e.touches[0].clientX : e.clientX;
        const clientY = e.type === 'touchmove' ? e.touches[0].clientY : e.clientY;

        const deltaX = clientX - dragStartX;
        const deltaY = clientY - dragStartY;

        const width = cropperViewport.clientWidth;
        const height = cropperViewport.clientHeight;

        const deltaPercentX = -(deltaX / (width * currentZoom)) * 100;
        const deltaPercentY = -(deltaY / (height * currentZoom)) * 100;

        let newX = Math.max(0, Math.min(100, dragStartPercentX + deltaPercentX));
        let newY = Math.max(0, Math.min(100, dragStartPercentY + deltaPercentY));

        newX = Math.round(newX);
        newY = Math.round(newY);

        currentPosPercent = { x: newX, y: newY };
        if (cropperImage) {
            cropperImage.style.objectPosition = `${newX}% ${newY}%`;
            cropperImage.style.transformOrigin = `${newX}% ${newY}%`;
        }
    };

    const onDragEnd = () => {
        isDraggingModalImage = false;
    };

    cropperGrabOverlay?.addEventListener('mousedown', onDragStart);
    window.addEventListener('mousemove', onDragMove);
    window.addEventListener('mouseup', onDragEnd);

    cropperGrabOverlay?.addEventListener('touchstart', onDragStart, { passive: true });
    window.addEventListener('touchmove', onDragMove, { passive: false });
    window.addEventListener('touchend', onDragEnd);

    // Attach click events to settings preview buttons
    document.getElementById('groom_photo_preview_btn')?.addEventListener('click', () => {
        openCropperModal('groom_photo', 'groom_photo_preview', 'Sesuaikan Foto Mempelai Pria', true);
    });
    document.getElementById('bride_photo_preview_btn')?.addEventListener('click', () => {
        openCropperModal('bride_photo', 'bride_photo_preview', 'Sesuaikan Foto Mempelai Wanita', true);
    });
    document.getElementById('hero_bg_preview_btn')?.addEventListener('click', () => {
        openCropperModal('hero_bg', 'hero_bg_preview', 'Sesuaikan Background Hero', false);
    });

    // Synchronize inputs changes
    document.getElementById('groom_photo')?.addEventListener('input', () => syncImageParams('groom_photo', 'groom_photo_preview'));
    document.getElementById('bride_photo')?.addEventListener('input', () => syncImageParams('bride_photo', 'bride_photo_preview'));
    document.getElementById('hero_bg')?.addEventListener('input', () => syncImageParams('hero_bg', 'hero_bg_preview'));

    // Handle image file uploads to Supabase Storage via backend upload API
    const handleFileUpload = async (fileInputId, textInputId) => {
        const fileInput = document.getElementById(fileInputId);
        const textInput = document.getElementById(textInputId);
        if (!fileInput || !fileInput.files || fileInput.files.length === 0 || !textInput) return;

        const file = fileInput.files[0];
        const originalVal = textInput.value;
        textInput.value = "Mengunggah berkas...";

        try {
            const fileExt = file.name.split('.').pop();
            const fileName = `${Date.now()}_${Math.random().toString(36).substring(2, 9)}.${fileExt}`;
            
            const formData = new FormData();
            formData.append('file', file);
            formData.append('fileName', fileName);
            formData.append('oldFileUrl', originalVal);
            const masterPass = document.getElementsByName('password')[0]?.value || '';
            formData.append('password', masterPass);

            const res = await fetch('/api/upload', {
                method: 'POST',
                body: formData
            });

            if (res.ok) {
                const result = await res.json();
                textInput.value = result.publicUrl;
                
                // Update preview immediately
                const previewId = textInputId + '_preview';
                syncImageParams(textInputId, previewId);

                triggerAdminToast("Berkas foto berhasil diunggah! Membuka editor posisi...");

                // Auto-open cropper modal for the newly uploaded file
                const isRound = textInputId !== 'hero_bg';
                const titleText = textInputId === 'groom_photo' ? 'Sesuaikan Foto Mempelai Pria' : 
                                  (textInputId === 'bride_photo' ? 'Sesuaikan Foto Mempelai Wanita' : 'Sesuaikan Background Hero');
                
                setTimeout(() => {
                    openCropperModal(textInputId, previewId, titleText, isRound);
                }, 400);
            } else {
                const err = await res.json();
                alert("Gagal mengunggah: " + (err.error || "Kesalahan server"));
                textInput.value = originalVal;
            }
        } catch (e) {
            console.error(e);
            alert("Gagal mengunggah foto. Pastikan Anda telah membuat storage bucket 'photos' di Supabase.");
            textInput.value = originalVal;
        }
    };

    document.getElementById('groom_photo_file')?.addEventListener('change', () => handleFileUpload('groom_photo_file', 'groom_photo'));
    document.getElementById('bride_photo_file')?.addEventListener('change', () => handleFileUpload('bride_photo_file', 'bride_photo'));
    document.getElementById('hero_bg_file')?.addEventListener('change', () => handleFileUpload('hero_bg_file', 'hero_bg'));

    // Client-side settings form handler
    const settingsForm = document.getElementById('settings-form');
    settingsForm?.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Collect form data
        const formData = new FormData(settingsForm);
        const data = {};
        formData.forEach((val, key) => {
            data[key] = val;
        });

        // Helper to convert picker datetime-local value to ISO UTC string
        const convertToUtcIso = (localVal) => {
            if (!localVal) return '';
            try {
                const d = new Date(localVal);
                if (isNaN(d.getTime())) return '';
                return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
            } catch (err) {
                return '';
            }
        };

        if (data['countdown_target_date']) {
            try {
                const d = new Date(data['countdown_target_date']);
                if (!isNaN(d.getTime())) {
                    data['countdown_target_date'] = d.toISOString();
                } else {
                    data['countdown_target_date'] = '';
                }
            } catch (err) {
                data['countdown_target_date'] = '';
            }
        }
        if (data['akad_start_iso']) {
            data['akad_start_iso'] = convertToUtcIso(data['akad_start_iso']);
        }
        if (data['akad_end_iso']) {
            data['akad_end_iso'] = convertToUtcIso(data['akad_end_iso']);
        }
        if (data['resepsi_start_iso']) {
            data['resepsi_start_iso'] = convertToUtcIso(data['resepsi_start_iso']);
        }
        if (data['resepsi_end_iso']) {
            data['resepsi_end_iso'] = convertToUtcIso(data['resepsi_end_iso']);
        }

        // Add the password from the master action form
        const masterPass = document.getElementsByName('password')[0]?.value || '';
        data['password'] = masterPass;

        // Show loading status
        const submitBtn = settingsForm.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.innerText = "MENYIMPAN...";

        try {
            const res = await fetch('/api/save-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (res.ok) {
                triggerAdminToast("Pengaturan berhasil disimpan!");
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } else {
                const err = await res.json();
                alert("Gagal menyimpan: " + (err.error || "Kesalahan server"));
            }
        } catch (err) {
            console.error(err);
            alert("Gagal terhubung ke server.");
        } finally {
            if (submitBtn) submitBtn.innerText = "SIMPAN PENGATURAN UNDANGAN";
        }
    });

    function triggerAdminToast(text) {
        const toast = document.getElementById('admin-toast');
        if (toast) {
            toast.innerText = text;
            toast.style.opacity = '1';
            toast.style.transform = 'translate(-50%, -20px)';
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translate(-50%, 0)';
            }, 3000);
        }
    }

    // Automatically trigger browser's calendar/time picker popup when clicking anywhere in the input
    document.querySelectorAll('input[type="datetime-local"]').forEach(input => {
        input.addEventListener('click', () => {
            try {
                input.showPicker();
            } catch (err) {
                console.warn('showPicker not supported on this browser:', err);
            }
        });
    });

    // Client-side dynamic refresh for disposable camera photos
    const refreshCameraBtn = document.getElementById('refresh-camera-btn');
    const cameraPhotosContainer = document.getElementById('camera-photos-container');

    refreshCameraBtn?.addEventListener('click', async () => {
        const originalText = refreshCameraBtn.innerHTML;
        refreshCameraBtn.disabled = true;
        refreshCameraBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memuat...';

        try {
            const masterPass = document.getElementsByName('password')[0]?.value || '';
            const res = await fetch(`/api/camera?adminPass=${encodeURIComponent(masterPass)}`);
            if (res.ok) {
                const photos = await res.json();
                
                // Group photos by guest
                const groups = {};
                photos.forEach(photo => {
                    const guest = photo.guest_id || 'Tamu Tanpa Nama';
                    if (!groups[guest]) {
                        groups[guest] = [];
                    }
                    groups[guest].push(photo);
                });

                if (Object.keys(groups).length === 0) {
                    cameraPhotosContainer.innerHTML = `
                        <div class="py-12 text-center text-stone-500 font-cinzel">
                            Belum ada foto yang diambil oleh tamu.
                        </div>
                    `;
                } else {
                    let html = '<div class="space-y-8">';
                    Object.entries(groups).forEach(([guestName, guestPhotos]) => {
                        html += `
                            <div class="border border-stone-800/60 bg-stone-950/40 rounded-xl p-5 space-y-4">
                                <div class="flex items-center justify-between border-b border-stone-800 pb-2">
                                    <div class="flex items-center gap-2">
                                        <div class="w-2 h-2 rounded-full bg-gold"></div>
                                        <h3 class="font-cinzel text-sm text-stone-200 font-bold tracking-wide">${guestName}</h3>
                                    </div>
                                    <span class="text-[10px] text-stone-500 font-mono">${guestPhotos.length} Foto</span>
                                </div>
                                <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-4">
                        `;
                        guestPhotos.forEach(photo => {
                            html += `
                                    <div class="group relative aspect-square bg-stone-900 border border-stone-800 rounded-lg overflow-hidden shadow-lg hover:scale-[1.03] transition-all" data-photo-card-id="${photo.id}">
                                        <img src="${photo.url}" class="w-full h-full object-cover" alt="Foto dari ${guestName}" loading="lazy" />
                                        <a 
                                            href="${photo.url}" 
                                            target="_blank" 
                                            rel="noopener noreferrer" 
                                            class="absolute inset-0 bg-stone-950/60 opacity-0 group-hover:opacity-100 flex items-center justify-center text-stone-200 text-xs font-cinzel uppercase tracking-wider transition-opacity duration-200"
                                        >
                                            Buka Foto
                                        </a>
                                        <button 
                                            class="admin-photo-delete-btn absolute top-2 right-2 z-20 w-7 h-7 bg-red-950/80 hover:bg-red-650 border border-red-900/40 text-red-400 hover:text-white rounded-full flex items-center justify-center transition-all cursor-pointer shadow-md opacity-0 group-hover:opacity-100"
                                            data-photo-id="${photo.id}"
                                            title="Hapus Foto Secara Permanen"
                                        >
                                            <i class="fa-solid fa-trash-can text-[10px]"></i>
                                        </button>
                                    </div>
                            `;
                        });
                        html += `
                                </div>
                            </div>
                        `;
                    });
                    html += '</div>';
                    cameraPhotosContainer.innerHTML = html;
                }
                
                triggerAdminToast("Daftar foto berhasil diperbarui!");
            } else {
                const err = await res.json();
                alert("Gagal memperbarui: " + (err.error || "Kesalahan server"));
            }
        } catch (e) {
            console.error(e);
            alert("Kesalahan koneksi saat memperbarui foto.");
        } finally {
            refreshCameraBtn.disabled = false;
            refreshCameraBtn.innerHTML = originalText;
        }
    });

    // Delete photo click listener delegation
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.admin-photo-delete-btn');
        if (!btn) return;
        
        const photoId = btn.getAttribute('data-photo-id');
        if (!photoId) return;

        if (!confirm('Hapus foto ini secara permanen dari server database dan storage?')) {
            return;
        }

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-[9px]"></i>';

        try {
            const masterPass = document.getElementsByName('password')[0]?.value || '';
            const res = await fetch(`/api/camera?id=${photoId}&adminPass=${encodeURIComponent(masterPass)}`, {
                method: 'DELETE'
            });

            if (res.ok) {
                const card = document.querySelector(`[data-photo-card-id="${photoId}"]`);
                if (card) {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.8)';
                    setTimeout(() => {
                        card.remove();
                        // Refresh container to regroup and recount photos
                        refreshCameraBtn?.click();
                    }, 300);
                }
                triggerAdminToast("Foto berhasil dihapus secara permanen!");
            } else {
                const err = await res.json();
                alert("Gagal menghapus: " + (err.error || "Kesalahan server"));
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        } catch (err) {
            console.error(err);
            alert("Kesalahan koneksi saat menghapus foto.");
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });

    // Admin Voice Playback logic (Event Delegation)
    let adminPlayingAudio = null;
    let adminPlayingBtn = null;

    document.addEventListener('click', (e) => {
        const btn = e.target.closest('.admin-voice-play-btn');
        if (!btn) return;
        
        const url = btn.getAttribute('data-voice-url');
        if (!url) return;

        if (adminPlayingBtn === btn) {
            if (adminPlayingAudio.paused) {
                adminPlayingAudio.play();
                btn.innerHTML = '<i class="fa-solid fa-pause text-[8px]"></i>';
            } else {
                adminPlayingAudio.pause();
                btn.innerHTML = '<i class="fa-solid fa-play text-[8px] translate-x-px"></i>';
            }
            return;
        }

        if (adminPlayingAudio) {
            adminPlayingAudio.pause();
            if (adminPlayingBtn) {
                adminPlayingBtn.innerHTML = '<i class="fa-solid fa-play text-[8px] translate-x-px"></i>';
            }
        }

        adminPlayingAudio = new Audio(url);
        adminPlayingBtn = btn;
        adminPlayingAudio.play();
        btn.innerHTML = '<i class="fa-solid fa-pause text-[8px]"></i>';

        adminPlayingAudio.addEventListener('ended', () => {
            btn.innerHTML = '<i class="fa-solid fa-play text-[8px] translate-x-px"></i>';
            adminPlayingAudio = null;
            adminPlayingBtn = null;
        });
    });

    // Client-side dynamic refresh for Supabase storage, database, and RSVP stats
    const refreshUsageBtn = document.getElementById('refresh-usage-btn');
    refreshUsageBtn?.addEventListener('click', async () => {
        const originalText = refreshUsageBtn.innerHTML;
        refreshUsageBtn.disabled = true;
        refreshUsageBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memuat...';

        try {
            const masterPass = document.getElementsByName('password')[0]?.value || '';
            const res = await fetch(`/api/admin-stats?adminPass=${encodeURIComponent(masterPass)}`);
            if (res.ok) {
                const data = await res.json();
                
                // Helper to format bytes client-side
                const formatBytes = (bytes, decimals = 2) => {
                    if (bytes === 0) return '0 Bytes';
                    const k = 1024;
                    const dm = decimals < 0 ? 0 : decimals;
                    const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
                    const i = Math.floor(Math.log(bytes) / Math.log(k));
                    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
                };

                const storage = data.storage;
                const db = data.database;

                const cameraSize = storage.camera.totalSize;
                const photosSize = storage.photos.totalSize;
                const totalStorageSize = cameraSize + photosSize;
                const totalStorageFiles = storage.camera.fileCount + storage.photos.fileCount;
                const storageLimit = 1024 * 1024 * 1024; // 1 GB
                const storagePercentage = Math.min((totalStorageSize / storageLimit) * 100, 100);
                const totalDbRows = db.wishesCount + db.voicesCount + db.cameraPhotosCount + db.cameraDeletionsCount;

                // RSVP calculations
                const rsvpCount = db.rsvp.count;
                const pctAttending = rsvpCount > 0 ? (db.rsvp.attending / rsvpCount) * 100 : 0;
                const pctNotAttending = rsvpCount > 0 ? (db.rsvp.notAttending / rsvpCount) * 100 : 0;
                const pctTentative = rsvpCount > 0 ? (db.rsvp.tentative / rsvpCount) * 100 : 0;
                const rsvpAverageGuests = db.rsvp.attending > 0 ? (db.rsvp.totalGuests / db.rsvp.attending) : 0;

                // Update Overview Cards
                const statTotalStorage = document.getElementById('stat-total-storage');
                if (statTotalStorage) statTotalStorage.innerText = formatBytes(totalStorageSize);

                const barTotalStorage = document.getElementById('bar-total-storage');
                if (barTotalStorage) barTotalStorage.style.width = `${storagePercentage}%`;

                const txtStorageFiles = document.getElementById('txt-storage-files');
                if (txtStorageFiles) txtStorageFiles.innerText = `${totalStorageFiles} file terunggah`;

                const txtStoragePercentage = document.getElementById('txt-storage-percentage');
                if (txtStoragePercentage) txtStoragePercentage.innerText = `${storagePercentage.toFixed(3)}% digunakan`;

                const statTotalRows = document.getElementById('stat-total-rows');
                if (statTotalRows) statTotalRows.innerText = totalDbRows;

                const barTotalRows = document.getElementById('bar-total-rows');
                if (barTotalRows) barTotalRows.style.width = `${Math.min((totalDbRows / 5000) * 100, 100)}%`;

                // Update RSVP Card
                const statRsvpGuests = document.getElementById('stat-rsvp-guests');
                if (statRsvpGuests) statRsvpGuests.innerText = db.rsvp.totalGuests;

                const barRsvpAttending = document.getElementById('bar-rsvp-attending');
                if (barRsvpAttending) {
                    barRsvpAttending.style.width = `${pctAttending}%`;
                    barRsvpAttending.title = `Hadir: ${pctAttending.toFixed(1)}%`;
                }

                const barRsvpNotAttending = document.getElementById('bar-rsvp-notattending');
                if (barRsvpNotAttending) {
                    barRsvpNotAttending.style.width = `${pctNotAttending}%`;
                    barRsvpNotAttending.title = `Tidak Hadir: ${pctNotAttending.toFixed(1)}%`;
                }

                const barRsvpTentative = document.getElementById('bar-rsvp-tentative');
                if (barRsvpTentative) {
                    barRsvpTentative.style.width = `${pctTentative}%`;
                    barRsvpTentative.title = `Ragu-ragu: ${pctTentative.toFixed(1)}%`;
                }

                const txtRsvpAverage = document.getElementById('txt-rsvp-average');
                if (txtRsvpAverage) txtRsvpAverage.innerText = `Rata-rata: ${rsvpAverageGuests.toFixed(1)} pax`;

                const txtRsvpTotal = document.getElementById('txt-rsvp-total');
                if (txtRsvpTotal) txtRsvpTotal.innerText = `${rsvpCount} respon`;

                // Update Bucket details
                const bucketCameraSize = document.getElementById('bucket-camera-size');
                if (bucketCameraSize) bucketCameraSize.innerText = formatBytes(cameraSize);

                const bucketCameraCount = document.getElementById('bucket-camera-count');
                if (bucketCameraCount) bucketCameraCount.innerText = `${storage.camera.fileCount} file`;

                const bucketPhotosSize = document.getElementById('bucket-photos-size');
                if (bucketPhotosSize) bucketPhotosSize.innerText = formatBytes(photosSize);

                const bucketPhotosCount = document.getElementById('bucket-photos-count');
                if (bucketPhotosCount) bucketPhotosCount.innerText = `${storage.photos.fileCount} file`;

                // Update Table rows count
                const tblRowWishes = document.getElementById('tbl-row-wishes');
                if (tblRowWishes) tblRowWishes.innerText = db.wishesCount;

                const tblRowVoices = document.getElementById('tbl-row-voices');
                if (tblRowVoices) tblRowVoices.innerText = db.voicesCount;

                const tblRowPhotos = document.getElementById('tbl-row-photos');
                if (tblRowPhotos) tblRowPhotos.innerText = db.cameraPhotosCount;

                const tblRowDeletions = document.getElementById('tbl-row-deletions');
                if (tblRowDeletions) tblRowDeletions.innerText = db.cameraDeletionsCount;

                const lblTotalFilesCount = document.getElementById('lbl-total-files-count');
                if (lblTotalFilesCount) lblTotalFilesCount.innerText = `${totalStorageFiles} Berkas Terdeteksi`;

                // Re-render storage files list
                const filesListBody = document.getElementById('files-list-body');
                if (filesListBody) {
                    const allFiles = [
                        ...storage.camera.fileList.map(f => ({ ...f, bucket: 'disposable-camera' })),
                        ...storage.photos.fileList.map(f => ({ ...f, bucket: 'photos' }))
                    ];
                    // Sort descending by updated_at
                    allFiles.sort((a, b) => new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime());

                    if (allFiles.length === 0) {
                        filesListBody.innerHTML = `
                            <tr id="files-list-empty">
                                <td colspan="4" class="py-8 text-center text-stone-500 font-cinzel">Tidak ada berkas yang tersimpan di storage.</td>
                            </tr>
                        `;
                    } else {
                        // Build sets for orphan detection client side
                        const activeDbUrls = new Set(db.activeDbUrls || []);
                        const activeSettingsUrls = new Set([
                            db.settings.groom_photo,
                            db.settings.bride_photo,
                            db.settings.hero_bg
                        ]);

                        let html = '';
                        allFiles.forEach(file => {
                            let isOrphan = false;
                            if (file.bucket === 'disposable-camera') {
                                isOrphan = !activeDbUrls.has(file.url);
                            } else if (file.bucket === 'photos') {
                                isOrphan = !activeSettingsUrls.has(file.url) && !activeSettingsUrls.has('/' + file.name) && !activeSettingsUrls.has(file.name);
                            }

                            const isLarge = file.size > 3 * 1024 * 1024;
                            const isAudio = file.name.endsWith('.mp3') || file.name.endsWith('.wav') || file.name.includes('/voices/');

                            html += `
                                <tr class="hover:bg-stone-900/40 transition" data-file-row-bucket="${file.bucket}" data-file-row-name="${file.name}">
                                    <td class="py-2 px-2 text-gold/80 text-[10px]">${file.bucket}</td>
                                    <td class="py-2 px-2 font-sans text-stone-200" title="${file.name}">
                                        <div class="flex flex-wrap items-center gap-1.5">
                                            <span class="truncate max-w-[200px] sm:max-w-xs">${file.name}</span>
                                            ${isOrphan ? `<span class="px-1.5 py-0.5 bg-red-950/80 text-red-400 border border-red-900/40 text-[8px] font-bold uppercase rounded font-mono select-none" title="Berkas ini tidak terhubung dengan ucapan atau pengaturan undangan. Aman untuk dihapus.">Orphan</span>` : ''}
                                            ${isLarge ? `<span class="px-1.5 py-0.5 bg-amber-950/80 text-amber-400 border border-amber-900/40 text-[8px] font-bold uppercase rounded font-mono select-none" title="Berkas berukuran besar (> 3MB) yang memakan kuota penyimpanan.">Besar</span>` : ''}
                                        </div>
                                    </td>
                                    <td class="py-2 px-2 text-right text-stone-300">${formatBytes(file.size)}</td>
                                    <td class="py-2 px-2 text-center">
                                        <div class="flex items-center justify-center gap-1.5">
                                            ${isAudio ? `
                                                <button 
                                                    class="admin-voice-play-btn w-6 h-6 rounded bg-stone-950 hover:bg-gold/20 text-stone-400 hover:text-gold border border-stone-850 hover:border-gold/30 flex items-center justify-center transition cursor-pointer active:scale-90"
                                                    data-voice-url="${file.url}"
                                                    title="Putar Rekaman Suara"
                                                >
                                                    <i class="fa-solid fa-play text-[8px] translate-x-px"></i>
                                                </button>
                                            ` : ''}
                                            
                                            <a 
                                                href="${file.url}" 
                                                target="_blank" 
                                                rel="noopener noreferrer" 
                                                class="inline-flex items-center justify-center w-6 h-6 rounded bg-stone-950 hover:bg-gold/20 text-stone-400 hover:text-gold border border-stone-850 hover:border-gold/30 transition cursor-pointer active:scale-95"
                                                title="Lihat Berkas di Tab Baru"
                                            >
                                                <i class="fa-solid fa-up-right-from-square text-[9px]"></i>
                                            </a>

                                            ${isOrphan ? `
                                                <button 
                                                    class="admin-file-delete-btn w-6 h-6 rounded bg-red-950/45 hover:bg-red-900/80 text-red-400 hover:text-white border border-red-900/40 hover:border-red-650 flex items-center justify-center transition cursor-pointer active:scale-90"
                                                    data-file-bucket="${file.bucket}"
                                                    data-file-path="${file.name}"
                                                    title="Hapus Berkas dari Storage secara Permanen"
                                                >
                                                    <i class="fa-solid fa-trash-can text-[9px]"></i>
                                                </button>
                                            ` : ''}
                                        </div>
                                    </td>
                                </tr>
                            `;
                        });
                        filesListBody.innerHTML = html;
                    }
                }

                // Re-render safety logs list
                const logsListBody = document.getElementById('logs-list-body');
                if (logsListBody) {
                    const logs = db.deletionsList || [];
                    if (logs.length === 0) {
                        logsListBody.innerHTML = `
                            <tr id="logs-list-empty">
                                <td colspan="3" class="py-8 text-center text-stone-500 font-cinzel">Belum ada riwayat log penghapusan foto.</td>
                            </tr>
                        `;
                    } else {
                        let html = '';
                        logs.forEach(log => {
                            const dateStr = new Date(log.deleted_at).toLocaleString('id-ID');
                            const guestName = log.guest_id.split('#')[0];
                            const guestIdPart = log.guest_id.includes('#') ? `<span class="text-[9px] text-stone-500 font-mono">#${log.guest_id.split('#')[1]}</span>` : '';
                            const fileName = log.photo_url.split('/').pop() || log.photo_url;
                            
                            html += `
                                <tr class="hover:bg-stone-900/40 transition">
                                    <td class="py-2 px-2 text-[10px] text-stone-400">${dateStr}</td>
                                    <td class="py-2 px-2 text-stone-200 font-sans">${guestName} ${guestIdPart}</td>
                                    <td class="py-2 px-2 truncate max-w-sm font-sans text-stone-400" title="${log.photo_url}">
                                        <a href="${log.photo_url}" target="_blank" rel="noopener noreferrer" class="hover:text-gold transition flex items-center gap-1.5">
                                            <i class="fa-solid fa-up-right-from-square text-[8px]"></i> ${fileName}
                                        </a>
                                    </td>
                                </tr>
                            `;
                        });
                        logsListBody.innerHTML = html;
                    }
                }

                triggerAdminToast("Statistik penyimpanan berhasil diperbarui!");
            } else {
                const err = await res.json();
                alert("Gagal memperbarui statistik: " + (err.error || "Kesalahan server"));
            }
        } catch (e) {
            console.error(e);
            alert("Kesalahan koneksi saat memperbarui statistik.");
        } finally {
            refreshUsageBtn.disabled = false;
            refreshUsageBtn.innerHTML = originalText;
        }
    });

    // Delete orphan file storage click handler delegation
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.admin-file-delete-btn');
        if (!btn) return;

        const bucket = btn.getAttribute('data-file-bucket');
        const filePath = btn.getAttribute('data-file-path');
        if (!bucket || !filePath) return;

        if (!confirm(`Hapus berkas "${filePath}" secara permanen dari Supabase Storage "${bucket}"? Tindakan ini tidak dapat dibatalkan.`)) {
            return;
        }

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-[9px]"></i>';

        try {
            const masterPass = document.getElementsByName('password')[0]?.value || '';
            const res = await fetch('/api/admin-storage-action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    action: 'delete-file',
                    password: masterPass,
                    bucket,
                    filePath
                })
            });

            if (res.ok) {
                const row = document.querySelector(`[data-file-row-bucket="${bucket}"][data-file-row-name="${filePath}"]`);
                if (row) {
                    row.style.opacity = '0';
                    row.style.transform = 'scale(0.8)';
                    setTimeout(() => {
                        row.remove();
                        refreshUsageBtn?.click();
                    }, 300);
                }
                triggerAdminToast("Berkas berhasil dihapus secara permanen dari storage!");
            } else {
                const err = await res.json();
                alert("Gagal menghapus berkas: " + (err.error || "Kesalahan server"));
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        } catch (err) {
            console.error(err);
            alert("Kesalahan koneksi saat menghapus berkas.");
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });

    // Clear deletion activity logs handler delegation
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('#clear-logs-btn');
        if (!btn) return;

        if (!confirm('Bersihkan semua riwayat audit log penghapusan foto secara permanen dari basis data? Batas hapus tamu tidak akan terpengaruh.')) {
            return;
        }

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1 text-[9px]"></i> Memproses...';

        try {
            const masterPass = document.getElementsByName('password')[0]?.value || '';
            const res = await fetch('/api/admin-storage-action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    action: 'clear-deletions-log',
                    password: masterPass
                })
            });

            if (res.ok) {
                triggerAdminToast("Log aktivitas berhasil dibersihkan!");
                refreshUsageBtn?.click();
            } else {
                const err = await res.json();
                alert("Gagal membersihkan log: " + (err.error || "Kesalahan server"));
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        } catch (err) {
            console.error(err);
            alert("Kesalahan koneksi saat membersihkan log.");
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    });
</script>
