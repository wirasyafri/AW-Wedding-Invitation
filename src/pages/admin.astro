                                        <tr class={`transition-colors hover:bg-stone-800/20 ${!wish.is_visible ? 'opacity-60 bg-stone-950/20' : ''}`}>
                                            <td class="py-4 px-6 font-bold text-stone-200">
                                                <div class="flex items-center gap-2">
