# Supabase Database Settings
# Replace with your actual Supabase project URL and anon key (found in Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Moderation Panel Password
# This is the password you will use to log in to /admin
ADMIN_PASSWORD=change_this_to_your_secure_password
